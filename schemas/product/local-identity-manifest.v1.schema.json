{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://echo.local/schemas/product/local-identity-manifest.v1.schema.json",
  "title": "ECHO local identity manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "manifest_id",
    "predecessor_manifest_id",
    "created_at",
    "authority",
    "organization",
    "principal",
    "membership",
    "installation",
    "identity_claims",
    "legacy_cutover",
    "integrity"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "echo-local-identity-manifest" },
    "manifest_id": { "$ref": "#/definitions/manifestId" },
    "predecessor_manifest_id": {
      "oneOf": [{ "$ref": "#/definitions/manifestId" }, { "type": "null" }]
    },
    "created_at": { "$ref": "#/definitions/timestamp" },
    "authority": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "assurance"],
          "properties": {
            "kind": { "const": "local-founder-bootstrap" },
            "assurance": { "const": "founder_attested" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "assurance"],
          "properties": {
            "kind": { "const": "organization-authority-enrollment" },
            "assurance": { "const": "authority_preprovisioned" }
          }
        }
      ]
    },
    "organization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["organization_id", "display_name", "created_at"],
      "properties": {
        "organization_id": { "$ref": "#/definitions/organizationId" },
        "display_name": { "$ref": "#/definitions/nonEmptyString" },
        "created_at": { "$ref": "#/definitions/timestamp" }
      }
    },
    "principal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["principal_id", "organization_id", "kind", "display_name"],
      "properties": {
        "principal_id": { "$ref": "#/definitions/principalId" },
        "organization_id": { "$ref": "#/definitions/organizationId" },
        "kind": { "const": "human" },
        "display_name": { "$ref": "#/definitions/nonEmptyString" }
      }
    },
    "membership": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "membership_id",
        "organization_id",
        "principal_id",
        "type",
        "status",
        "valid_from"
      ],
      "properties": {
        "membership_id": { "$ref": "#/definitions/membershipId" },
        "organization_id": { "$ref": "#/definitions/organizationId" },
        "principal_id": { "$ref": "#/definitions/principalId" },
        "type": { "enum": ["owner", "employee", "contractor"] },
        "status": { "const": "active" },
        "valid_from": { "$ref": "#/definitions/timestamp" }
      }
    },
    "installation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "installation_id",
        "organization_id",
        "membership_id",
        "device_id",
        "device_class",
        "enrolled_at",
        "product",
        "signing_key"
      ],
      "properties": {
        "installation_id": { "$ref": "#/definitions/installationId" },
        "organization_id": { "$ref": "#/definitions/organizationId" },
        "membership_id": { "$ref": "#/definitions/membershipId" },
        "device_id": { "$ref": "#/definitions/deviceId" },
        "device_class": { "enum": ["byod", "managed"] },
        "enrolled_at": { "$ref": "#/definitions/timestamp" },
        "product": { "$ref": "#/definitions/product" },
        "signing_key": { "$ref": "#/definitions/signingKey" }
      }
    },
    "identity_claims": {
      "type": "array",
      "items": { "$ref": "#/definitions/identityClaim" }
    },
    "legacy_cutover": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "declared_at",
        "pre_cutover_default",
        "native_records_require"
      ],
      "properties": {
        "declared_at": { "$ref": "#/definitions/timestamp" },
        "pre_cutover_default": { "const": "disposable_test" },
        "native_records_require": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "enum": [
              "source-attribution-v1",
              "processor-attribution-v1",
              "approval-context-v1",
              "signed-outbox-v1"
            ]
          },
          "allOf": [
            { "contains": { "const": "source-attribution-v1" } },
            { "contains": { "const": "processor-attribution-v1" } },
            { "contains": { "const": "approval-context-v1" } },
            { "contains": { "const": "signed-outbox-v1" } }
          ]
        }
      }
    },
    "integrity": { "$ref": "#/definitions/integrity" }
  },
  "definitions": {
    "manifestId": {
      "type": "string",
      "pattern": "^idm_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "organizationId": {
      "type": "string",
      "pattern": "^org_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "principalId": {
      "type": "string",
      "pattern": "^prn_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "membershipId": {
      "type": "string",
      "pattern": "^mem_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "installationId": {
      "type": "string",
      "pattern": "^ins_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "deviceId": {
      "type": "string",
      "pattern": "^dev_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "claimId": {
      "type": "string",
      "pattern": "^clm_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "timestamp": {
      "type": "string",
      "format": "utc-millisecond-timestamp",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$"
    },
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "base64": {
      "type": "string",
      "minLength": 4,
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "source_sha"],
      "properties": {
        "name": { "const": "echo-brain" },
        "version": { "$ref": "#/definitions/nonEmptyString" },
        "source_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "signingKey": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "key_id",
            "algorithm",
            "public_key_spki_der_base64",
            "protection",
            "assurance"
          ],
          "properties": {
            "key_id": { "$ref": "#/definitions/digest" },
            "algorithm": { "const": "ecdsa-p256-sha256-der-low-s" },
            "public_key_spki_der_base64": { "$ref": "#/definitions/base64" },
            "protection": { "const": "secure-enclave" },
            "assurance": { "const": "hardware_bound" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "key_id",
            "algorithm",
            "public_key_spki_der_base64",
            "protection",
            "assurance"
          ],
          "properties": {
            "key_id": { "$ref": "#/definitions/digest" },
            "algorithm": { "const": "ecdsa-p256-sha256-der-low-s" },
            "public_key_spki_der_base64": { "$ref": "#/definitions/base64" },
            "protection": { "const": "keychain-this-device-only" },
            "assurance": { "const": "platform_key_device_only" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "key_id",
            "algorithm",
            "public_key_spki_der_base64",
            "protection",
            "assurance"
          ],
          "properties": {
            "key_id": { "$ref": "#/definitions/digest" },
            "algorithm": { "const": "ecdsa-p256-sha256-der-low-s" },
            "public_key_spki_der_base64": { "$ref": "#/definitions/base64" },
            "protection": { "const": "development-file" },
            "assurance": { "const": "software_key_development_only" }
          }
        }
      ]
    },
    "identityClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id",
        "principal_id",
        "issuer",
        "subject",
        "verification"
      ],
      "properties": {
        "claim_id": { "$ref": "#/definitions/claimId" },
        "principal_id": { "$ref": "#/definitions/principalId" },
        "issuer": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "provider", "tenant_id"],
              "properties": {
                "kind": { "const": "provider" },
                "provider": { "$ref": "#/definitions/nonEmptyString" },
                "tenant_id": { "$ref": "#/definitions/nonEmptyString" }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "issuer_uri"],
              "properties": {
                "kind": { "const": "oidc" },
                "issuer_uri": {
                  "type": "string",
                  "pattern": "^https://"
                }
              }
            }
          ]
        },
        "subject": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "id"],
          "properties": {
            "kind": { "enum": ["user", "oidc_sub"] },
            "id": { "$ref": "#/definitions/nonEmptyString" }
          }
        },
        "verification": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "method",
                "assurance",
                "verified_at",
                "evidence_sha256"
              ],
              "properties": {
                "method": {
                  "enum": ["slack_dm_challenge", "email_magic_link"]
                },
                "assurance": {
                  "enum": ["provider_challenge_observed", "provider_verified"]
                },
                "verified_at": { "$ref": "#/definitions/timestamp" },
                "evidence_sha256": { "$ref": "#/definitions/digest" }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "method",
                "assurance",
                "verified_at",
                "evidence_sha256",
                "audience",
                "authentication_time",
                "nonce_sha256"
              ],
              "properties": {
                "method": { "const": "oidc_id_token" },
                "assurance": { "const": "provider_verified" },
                "verified_at": { "$ref": "#/definitions/timestamp" },
                "evidence_sha256": { "$ref": "#/definitions/digest" },
                "audience": { "$ref": "#/definitions/nonEmptyString" },
                "authentication_time": { "$ref": "#/definitions/timestamp" },
                "nonce_sha256": { "$ref": "#/definitions/digest" }
              }
            }
          ]
        }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonicalization",
        "payload_sha256",
        "signature_algorithm",
        "key_id",
        "signature_base64"
      ],
      "properties": {
        "canonicalization": { "const": "RFC8785" },
        "payload_sha256": { "$ref": "#/definitions/digest" },
        "signature_algorithm": { "const": "ecdsa-p256-sha256-der-low-s" },
        "key_id": { "$ref": "#/definitions/digest" },
        "signature_base64": { "$ref": "#/definitions/base64" }
      }
    }
  }
}
