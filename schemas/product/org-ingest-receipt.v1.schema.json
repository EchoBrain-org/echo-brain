{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://echo.local/schemas/product/org-ingest-receipt.v1.schema.json",
  "title": "ECHO organization ingest receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "receipt_id",
    "authority_id",
    "authority_key_id",
    "organization_id",
    "membership_id",
    "membership_version",
    "installation_id",
    "installation_version",
    "enrollment_receipt_sha256",
    "event_id",
    "record_id",
    "sequence",
    "event_sha256",
    "batch_sha256",
    "status",
    "canonical_record_id",
    "server_received_at",
    "policy_version",
    "reason",
    "authority_head",
    "integrity"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "echo-org-ingest-receipt" },
    "receipt_id": { "$ref": "#/definitions/receiptId" },
    "authority_id": { "$ref": "#/definitions/authorityId" },
    "authority_key_id": { "$ref": "#/definitions/digest" },
    "organization_id": { "$ref": "#/definitions/organizationId" },
    "membership_id": { "$ref": "#/definitions/membershipId" },
    "membership_version": { "type": "integer", "minimum": 1 },
    "installation_id": { "$ref": "#/definitions/installationId" },
    "installation_version": { "type": "integer", "minimum": 1 },
    "enrollment_receipt_sha256": { "$ref": "#/definitions/digest" },
    "event_id": { "$ref": "#/definitions/eventId" },
    "record_id": { "$ref": "#/definitions/recordId" },
    "sequence": { "type": "integer", "minimum": 1 },
    "event_sha256": { "$ref": "#/definitions/digest" },
    "batch_sha256": { "$ref": "#/definitions/digest" },
    "status": {
      "enum": ["accepted", "duplicate", "rejected", "quarantined"]
    },
    "canonical_record_id": {
      "oneOf": [{ "$ref": "#/definitions/recordId" }, { "type": "null" }]
    },
    "server_received_at": { "$ref": "#/definitions/timestamp" },
    "policy_version": { "type": "integer", "minimum": 1 },
    "reason": {
      "oneOf": [{ "$ref": "#/definitions/reason" }, { "type": "null" }]
    },
    "authority_head": { "$ref": "#/definitions/authorityHead" },
    "integrity": { "$ref": "#/definitions/integrity" }
  },
  "allOf": [
    {
      "if": {
        "required": ["status"],
        "properties": {
          "status": { "enum": ["accepted", "duplicate"] }
        }
      },
      "then": {
        "properties": {
          "canonical_record_id": { "$ref": "#/definitions/recordId" },
          "reason": { "type": "null" }
        }
      },
      "else": {
        "properties": {
          "canonical_record_id": { "type": "null" },
          "reason": { "$ref": "#/definitions/reason" }
        }
      }
    }
  ],
  "definitions": {
    "receiptId": {
      "type": "string",
      "pattern": "^igr_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "authorityId": {
      "type": "string",
      "pattern": "^oau_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "organizationId": {
      "type": "string",
      "pattern": "^org_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "membershipId": {
      "type": "string",
      "pattern": "^mem_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "installationId": {
      "type": "string",
      "pattern": "^ins_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "eventId": {
      "type": "string",
      "pattern": "^evt_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "recordId": {
      "type": "string",
      "pattern": "^rec_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "timestamp": {
      "type": "string",
      "format": "utc-millisecond-timestamp",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$"
    },
    "reason": {
      "enum": [
        "membership_revoked",
        "installation_revoked",
        "sequence_gap",
        "sequence_fork",
        "previous_event_hash_mismatch",
        "event_id_conflict",
        "record_id_conflict",
        "local_subject_conflict"
      ]
    },
    "authorityHead": {
      "type": "object",
      "additionalProperties": false,
      "required": ["last_sequence", "last_event_hash"],
      "properties": {
        "last_sequence": { "type": "integer", "minimum": 0 },
        "last_event_hash": {
          "oneOf": [{ "$ref": "#/definitions/digest" }, { "type": "null" }]
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["last_sequence"],
            "properties": { "last_sequence": { "const": 0 } }
          },
          "then": {
            "properties": { "last_event_hash": { "type": "null" } }
          },
          "else": {
            "properties": {
              "last_event_hash": { "$ref": "#/definitions/digest" }
            }
          }
        }
      ]
    },
    "base64": {
      "type": "string",
      "minLength": 4,
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonicalization",
        "payload_sha256",
        "signature_algorithm",
        "key_id",
        "signature_base64"
      ],
      "properties": {
        "canonicalization": { "const": "RFC8785" },
        "payload_sha256": { "$ref": "#/definitions/digest" },
        "signature_algorithm": { "const": "ecdsa-p256-sha256-der-low-s" },
        "key_id": { "$ref": "#/definitions/digest" },
        "signature_base64": { "$ref": "#/definitions/base64" }
      }
    }
  }
}
