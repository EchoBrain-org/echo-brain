{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://echo.local/schemas/product/federated-recovery-report.v1.schema.json",
  "title": "ECHO unsigned federated recovery report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "unsigned",
    "reason",
    "organization_id",
    "installation_id",
    "identity_manifest_sha256",
    "records",
    "generated_at"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "echo-federated-recovery-report" },
    "unsigned": { "const": true },
    "reason": { "const": "installation-key-unavailable" },
    "organization_id": { "$ref": "#/definitions/organizationId" },
    "installation_id": { "$ref": "#/definitions/installationId" },
    "identity_manifest_sha256": { "$ref": "#/definitions/digest" },
    "records": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "count",
        "individually_verified",
        "verification_failures",
        "sha256"
      ],
      "properties": {
        "path": { "const": "records.v1.jsonl" },
        "count": { "type": "integer", "minimum": 0 },
        "individually_verified": { "type": "integer", "minimum": 0 },
        "verification_failures": {
          "type": "array",
          "items": { "$ref": "#/definitions/jsonValue" }
        },
        "sha256": { "$ref": "#/definitions/digest" }
      }
    },
    "generated_at": { "$ref": "#/definitions/timestamp" }
  },
  "definitions": {
    "organizationId": {
      "type": "string",
      "pattern": "^org_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "installationId": {
      "type": "string",
      "pattern": "^ins_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "timestamp": {
      "type": "string",
      "format": "utc-millisecond-timestamp",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$"
    },
    "jsonObject": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": { "^.*$": { "$ref": "#/definitions/jsonValue" } }
    },
    "jsonValue": {
      "oneOf": [
        { "type": "null" },
        { "type": "boolean" },
        { "type": "number" },
        { "type": "string" },
        { "type": "array", "items": { "$ref": "#/definitions/jsonValue" } },
        { "$ref": "#/definitions/jsonObject" }
      ]
    }
  }
}
