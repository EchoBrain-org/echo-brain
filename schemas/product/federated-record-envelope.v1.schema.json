          "oneOf": [
            { "$ref": "#/definitions/nonEmptyString" },
            { "type": "null" }
          ]
        },
        "bot_user_id": { "$ref": "#/definitions/nonEmptyString" },
        "bot_id": {
          "oneOf": [
            { "$ref": "#/definitions/nonEmptyString" },
            { "type": "null" }
          ]
        },
        "app_id": {
          "oneOf": [
            { "$ref": "#/definitions/nonEmptyString" },
            { "type": "null" }
          ]
        }
      }
    },
    "approvalSurface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["binding", "connection", "presentation"],
      "properties": {
        "binding": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "adapter_binding_id",
            "adapter",
            "configuration_snapshot",
            "configuration_sha256"
          ],
          "properties": {
            "adapter_binding_id": { "$ref": "#/definitions/bindingId" },
            "adapter": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "adapter_id", "instance_id", "version"],
              "properties": {
                "kind": { "const": "approval-surface" },
                "adapter_id": { "$ref": "#/definitions/adapterName" },
                "instance_id": { "$ref": "#/definitions/adapterName" },
                "version": { "$ref": "#/definitions/nonEmptyString" }
              }
            },
            "configuration_snapshot": { "$ref": "#/definitions/jsonObject" },
            "configuration_sha256": { "$ref": "#/definitions/digest" }
          }
        },
        "connection": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "connection_id",
            "generation",
            "owner",
            "provider_identity"
          ],
          "properties": {
            "connection_id": { "$ref": "#/definitions/connectionId" },
            "generation": { "type": "integer", "minimum": 1 },
            "owner": { "$ref": "#/definitions/owner" },
            "provider_identity": {
              "$ref": "#/definitions/slackProviderIdentity"
            }
          }
        },
        "presentation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["channel_id", "message_ts", "rendered_blocks_sha256"],
          "properties": {
            "channel_id": { "$ref": "#/definitions/nonEmptyString" },
            "message_ts": {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]{6}$"
            },
            "rendered_blocks_sha256": { "$ref": "#/definitions/digest" }
          }
        }
      }
    },
    "approvalObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["binding", "connection", "observed_by"],
      "properties": {
        "binding": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "adapter_binding_id",
            "adapter",
            "configuration_snapshot",
            "configuration_sha256"
          ],
          "properties": {
            "adapter_binding_id": { "$ref": "#/definitions/bindingId" },
            "adapter": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "adapter_id", "instance_id", "version"],
              "properties": {
                "kind": { "const": "approval-surface" },
                "adapter_id": { "$ref": "#/definitions/adapterName" },
                "instance_id": { "$ref": "#/definitions/adapterName" },
                "version": { "$ref": "#/definitions/nonEmptyString" }
              }
            },
            "configuration_snapshot": { "$ref": "#/definitions/jsonObject" },
            "configuration_sha256": { "$ref": "#/definitions/digest" }
          }
        },
        "connection": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "connection_id",
            "generation",
            "owner",
            "provider_identity"
          ],
          "properties": {
            "connection_id": { "$ref": "#/definitions/connectionId" },
            "generation": { "type": "integer", "minimum": 1 },
            "owner": { "$ref": "#/definitions/owner" },
            "provider_identity": {
              "$ref": "#/definitions/slackProviderIdentity"
            }
          }
        },
        "observed_by": { "$ref": "#/definitions/productArtifact" }
      }
    },
    "slackRawActor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "tenant_id",
        "subject_id",
        "display_name",
        "channel_id",
        "message_ts",
        "action",
        "reason_reply"
      ],
      "properties": {
        "provider": { "const": "slack" },
        "tenant_id": { "$ref": "#/definitions/nonEmptyString" },
        "subject_id": { "$ref": "#/definitions/nonEmptyString" },
        "display_name": { "$ref": "#/definitions/nonEmptyString" },
        "channel_id": { "$ref": "#/definitions/nonEmptyString" },
        "message_ts": { "type": "string", "pattern": "^[0-9]+\\.[0-9]{6}$" },
        "action": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "name", "provider_occurred_at", "observed_at"],
          "properties": {
            "kind": { "const": "reaction" },
            "name": { "$ref": "#/definitions/nonEmptyString" },
            "provider_occurred_at": {
              "$ref": "#/definitions/nullableTimestamp"
            },
            "observed_at": { "$ref": "#/definitions/timestamp" }
          }
        },
        "reason_reply": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["message_ts", "author_subject_id", "text_sha256"],
              "properties": {
                "message_ts": {
                  "type": "string",
                  "pattern": "^[0-9]+\\.[0-9]{6}$"
                },
                "author_subject_id": { "$ref": "#/definitions/nonEmptyString" },
                "text_sha256": { "$ref": "#/definitions/digest" }
              }
            },
            { "type": "null" }
          ]
        }
      }
    },
    "slackApproval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface",
        "observation",
        "approver",
        "raw_actor_assertion",
        "assurance",
        "reviewed_at",
        "reason",
        "approved_brief_sha256",
        "approved_context_sha256"
      ],
      "properties": {
        "surface": { "$ref": "#/definitions/approvalSurface" },
        "observation": { "$ref": "#/definitions/approvalObservation" },
