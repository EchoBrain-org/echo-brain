{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://echo.local/schemas/product/federated-record-envelope.v1.schema.json",
  "title": "ECHO federated record envelope",
  "allOf": [{ "$ref": "#/definitions/approvedOrgRecord" }],
  "definitions": {
    "approvedOrgRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "kind",
        "event_type",
        "event_id",
        "organization_id",
        "sequence",
        "previous_event_hash",
        "occurred_at",
        "producer",
        "source",
        "processor",
        "local_reference",
        "record",
        "approval",
        "publication",
        "classification",
        "identity_manifest_sha256",
        "integrity"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "kind": { "const": "echo-federated-event" },
        "event_type": { "const": "approved-org-record" },
        "event_id": { "$ref": "#/definitions/eventId" },
        "organization_id": { "$ref": "#/definitions/organizationId" },
        "sequence": { "type": "integer", "minimum": 1 },
        "previous_event_hash": {
          "oneOf": [{ "$ref": "#/definitions/digest" }, { "type": "null" }]
        },
        "occurred_at": { "$ref": "#/definitions/timestamp" },
        "producer": { "$ref": "#/definitions/nativeProducer" },
        "source": { "$ref": "#/definitions/source" },
        "processor": { "$ref": "#/definitions/processor" },
        "local_reference": { "$ref": "#/definitions/nativeLocalReference" },
        "record": { "$ref": "#/definitions/record" },
        "approval": { "$ref": "#/definitions/approval" },
        "publication": { "$ref": "#/definitions/publicationSnapshot" },
        "classification": { "const": "native_attributed" },
        "identity_manifest_sha256": { "$ref": "#/definitions/digest" },
        "integrity": { "$ref": "#/definitions/integrity" }
      }
    },
    "eventId": {
      "type": "string",
      "pattern": "^evt_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "recordId": {
      "type": "string",
      "pattern": "^rec_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "organizationId": {
      "type": "string",
      "pattern": "^org_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "principalId": {
      "type": "string",
      "pattern": "^prn_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "membershipId": {
      "type": "string",
      "pattern": "^mem_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "installationId": {
      "type": "string",
      "pattern": "^ins_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "manifestId": {
      "type": "string",
      "pattern": "^idm_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "claimId": {
      "type": "string",
      "pattern": "^clm_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "policyId": {
      "type": "string",
      "pattern": "^pol_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "bindingId": {
      "type": "string",
      "pattern": "^bnd_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "connectionId": {
      "type": "string",
      "pattern": "^con_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "observationId": {
      "type": "string",
      "pattern": "^obs_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "adapterName": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "timestamp": {
      "type": "string",
      "format": "utc-millisecond-timestamp",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$"
    },
    "nullableTimestamp": {
      "oneOf": [{ "$ref": "#/definitions/timestamp" }, { "type": "null" }]
    },
    "base64": {
      "type": "string",
      "minLength": 4,
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
    },
    "signalId": {
      "type": "string",
      "pattern": "^(?:decision|action|rationale):sha256:[0-9a-f]{64}$"
    },
    "productArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["product_version", "source_sha", "artifact_sha256"],
      "properties": {
        "product_version": { "$ref": "#/definitions/nonEmptyString" },
        "source_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "artifact_sha256": { "$ref": "#/definitions/digest" }
      }
    },
    "nativeProducer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "principal_id",
        "membership_id",
        "installation_id",
        "key_id",
        "membership_assertion",
        "product_artifact"
      ],
      "properties": {
        "principal_id": { "$ref": "#/definitions/principalId" },
        "membership_id": { "$ref": "#/definitions/membershipId" },
        "installation_id": { "$ref": "#/definitions/installationId" },
        "key_id": { "$ref": "#/definitions/digest" },
        "membership_assertion": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["status", "authority", "assurance"],
              "properties": {
                "status": { "const": "active" },
                "authority": { "const": "local-founder-bootstrap" },
                "assurance": { "const": "founder_attested" }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["status", "authority", "assurance"],
              "properties": {
                "status": { "const": "active" },
                "authority": {
                  "const": "organization-authority-enrollment"
                },
                "assurance": { "const": "authority_preprovisioned" }
              }
            }
          ]
        },
        "product_artifact": { "$ref": "#/definitions/productArtifact" }
      }
    },
    "owner": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "id"],
          "properties": {
            "kind": { "const": "organization" },
            "id": { "$ref": "#/definitions/organizationId" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "id"],
          "properties": {
            "kind": { "const": "membership" },
            "id": { "$ref": "#/definitions/membershipId" }
          }
        }
      ]
    },
    "providerTenant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "enterprise_id"],
      "properties": {
        "kind": { "$ref": "#/definitions/nonEmptyString" },
        "id": { "$ref": "#/definitions/nonEmptyString" },
        "enterprise_id": {
          "oneOf": [
            { "$ref": "#/definitions/nonEmptyString" },
            { "type": "null" }
          ]
        }
      }
    },
    "providerSubject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "bot_id", "app_id"],
      "properties": {
        "kind": { "$ref": "#/definitions/nonEmptyString" },
        "id": { "$ref": "#/definitions/nonEmptyString" },
        "bot_id": {
          "oneOf": [
            { "$ref": "#/definitions/nonEmptyString" },
            { "type": "null" }
          ]
        },
        "app_id": {
          "oneOf": [
            { "$ref": "#/definitions/nonEmptyString" },
            { "type": "null" }
          ]
        }
      }
    },
    "participantObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["meeting_participant_id", "display_name", "observed_claims"],
      "properties": {
        "meeting_participant_id": { "$ref": "#/definitions/nonEmptyString" },
        "display_name": {
          "oneOf": [
            { "$ref": "#/definitions/nonEmptyString" },
            { "type": "null" }
          ]
        },
        "observed_claims": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["namespace", "kind", "value"],
            "properties": {
              "namespace": { "$ref": "#/definitions/nonEmptyString" },
              "kind": { "enum": ["source", "email", "phone", "other"] },
              "value": { "$ref": "#/definitions/nonEmptyString" }
            }
          }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity_manifest_id",
        "identity_manifest_sha256",
        "binding",
        "connection",
        "meeting",
        "participant_observations",
        "attribution_sha256",
        "observed_by"
      ],
      "properties": {
        "identity_manifest_id": { "$ref": "#/definitions/manifestId" },
        "identity_manifest_sha256": { "$ref": "#/definitions/digest" },
        "binding": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "adapter_binding_id",
            "adapter",
            "configuration_snapshot",
            "configuration_sha256"
          ],
          "properties": {
            "adapter_binding_id": { "$ref": "#/definitions/bindingId" },
            "adapter": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "adapter_id", "instance_id", "version"],
              "properties": {
                "kind": { "const": "meeting-source" },
                "adapter_id": { "$ref": "#/definitions/adapterName" },
                "instance_id": { "$ref": "#/definitions/adapterName" },
                "version": { "$ref": "#/definitions/nonEmptyString" }
              }
            },
            "configuration_snapshot": { "$ref": "#/definitions/jsonObject" },
            "configuration_sha256": { "$ref": "#/definitions/digest" }
          }
        },
        "connection": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "connection_id",
            "generation",
            "owner",
            "provider_identity"
          ],
          "properties": {
            "connection_id": { "$ref": "#/definitions/connectionId" },
            "generation": { "type": "integer", "minimum": 1 },
            "owner": { "$ref": "#/definitions/owner" },
            "provider_identity": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "provider",
                "tenant",
                "subject",
                "verification_method",
                "assurance"
              ],
              "properties": {
                "provider": { "$ref": "#/definitions/adapterName" },
                "tenant": {
                  "oneOf": [
                    { "$ref": "#/definitions/providerTenant" },
                    { "type": "null" }
                  ]
                },
                "subject": {
                  "oneOf": [
                    { "$ref": "#/definitions/providerSubject" },
                    { "type": "null" }
                  ]
                },
                "verification_method": {
                  "enum": [
                    "slack_auth_test",
                    "provider_first_capture",
                    "operator_attestation"
                  ]
                },
                "assurance": {
                  "enum": [
                    "provider_verified",
                    "credential_observed",
                    "operator_attested"
                  ]
                }
              }
            }
          }
        },
        "meeting": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "external_id",
            "revision",
            "source_observation_id",
            "document_sha256"
          ],
          "properties": {
            "external_id": { "$ref": "#/definitions/nonEmptyString" },
            "revision": { "$ref": "#/definitions/nonEmptyString" },
            "source_observation_id": { "$ref": "#/definitions/observationId" },
            "document_sha256": { "$ref": "#/definitions/digest" }
          }
        },
        "participant_observations": {
          "type": "array",
          "items": { "$ref": "#/definitions/participantObservation" }
        },
        "attribution_sha256": { "$ref": "#/definitions/digest" },
        "observed_by": { "$ref": "#/definitions/productArtifact" }
      }
    },
    "processor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity_manifest_id",
        "identity_manifest_sha256",
        "adapter_binding_id",
        "adapter",
        "configuration_snapshot",
        "configuration_sha256",
        "attribution_sha256",
        "decision_set_sha256",
        "generated_at",
        "produced_by"
      ],
      "properties": {
        "identity_manifest_id": { "$ref": "#/definitions/manifestId" },
        "identity_manifest_sha256": { "$ref": "#/definitions/digest" },
        "adapter_binding_id": { "$ref": "#/definitions/bindingId" },
        "adapter": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "adapter_id", "instance_id", "version"],
          "properties": {
            "kind": { "const": "decision-processor" },
            "adapter_id": { "$ref": "#/definitions/adapterName" },
            "instance_id": { "$ref": "#/definitions/adapterName" },
            "version": { "$ref": "#/definitions/nonEmptyString" }
          }
        },
        "configuration_snapshot": { "$ref": "#/definitions/jsonObject" },
        "configuration_sha256": { "$ref": "#/definitions/digest" },
        "attribution_sha256": { "$ref": "#/definitions/digest" },
        "decision_set_sha256": { "$ref": "#/definitions/digest" },
        "generated_at": { "$ref": "#/definitions/timestamp" },
        "produced_by": { "$ref": "#/definitions/productArtifact" }
      }
    },
    "nativeLocalReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "processing_key",
        "approval_id",
        "node_id",
        "meeting_id",
        "signal_id"
      ],
      "properties": {
        "processing_key": { "$ref": "#/definitions/nonEmptyString" },
        "approval_id": { "$ref": "#/definitions/nonEmptyString" },
        "node_id": { "$ref": "#/definitions/nonEmptyString" },
        "meeting_id": { "$ref": "#/definitions/nonEmptyString" },
        "signal_id": { "$ref": "#/definitions/signalId" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["meeting_id", "block_id"],
      "properties": {
        "meeting_id": { "$ref": "#/definitions/nonEmptyString" },
        "block_id": { "$ref": "#/definitions/nonEmptyString" },
        "quote": { "$ref": "#/definitions/nonEmptyString" },
        "started_at": { "$ref": "#/definitions/timestamp" },
        "ended_at": { "$ref": "#/definitions/timestamp" }
      }
    },
    "decisionSignal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "text",
        "subject",
        "confidence",
        "evidence",
        "status"
      ],
      "properties": {
        "id": { "$ref": "#/definitions/signalId" },
        "kind": { "const": "decision" },
        "text": { "$ref": "#/definitions/nonEmptyString" },
        "subject": {
          "oneOf": [
            { "$ref": "#/definitions/nonEmptyString" },
            { "type": "null" }
          ]
        },
        "confidence": {
          "oneOf": [
            { "type": "number", "minimum": 0, "maximum": 1 },
            { "type": "null" }
          ]
        },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/definitions/evidence" }
        },
        "status": { "enum": ["proposed", "decided", "unresolved"] }
      }
    },
    "actionSignal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "text",
        "subject",
        "confidence",
        "evidence",
        "owner",
        "due_at"
      ],
      "properties": {
        "id": { "$ref": "#/definitions/signalId" },
        "kind": { "const": "action" },
        "text": { "$ref": "#/definitions/nonEmptyString" },
        "subject": {
          "oneOf": [
            { "$ref": "#/definitions/nonEmptyString" },
            { "type": "null" }
          ]
        },
        "confidence": {
          "oneOf": [
            { "type": "number", "minimum": 0, "maximum": 1 },
            { "type": "null" }
          ]
        },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/definitions/evidence" }
        },
        "owner": {
          "oneOf": [
            { "$ref": "#/definitions/nonEmptyString" },
            { "type": "null" }
          ]
        },
        "due_at": { "$ref": "#/definitions/nullableTimestamp" }
      }
    },
    "rationaleSignal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "text",
        "subject",
        "confidence",
        "evidence",
        "supports_signal_ids"
      ],
      "properties": {
        "id": { "$ref": "#/definitions/signalId" },
        "kind": { "const": "rationale" },
        "text": { "$ref": "#/definitions/nonEmptyString" },
        "subject": {
          "oneOf": [
            { "$ref": "#/definitions/nonEmptyString" },
            { "type": "null" }
          ]
        },
        "confidence": {
          "oneOf": [
            { "type": "number", "minimum": 0, "maximum": 1 },
            { "type": "null" }
          ]
        },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/definitions/evidence" }
        },
        "supports_signal_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/signalId" }
        }
      }
    },
    "meetingTime": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scheduled_start_at": { "$ref": "#/definitions/timestamp" },
        "scheduled_end_at": { "$ref": "#/definitions/timestamp" },
        "actual_start_at": { "$ref": "#/definitions/timestamp" },
        "actual_end_at": { "$ref": "#/definitions/timestamp" },
        "timezone": { "$ref": "#/definitions/nonEmptyString" },
        "all_day": { "type": "boolean" }
      }
    },
    "meetingParticipant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "$ref": "#/definitions/nonEmptyString" },
        "display_name": { "$ref": "#/definitions/nonEmptyString" },
        "identities": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "value"],
            "properties": {
              "kind": { "enum": ["source", "email", "phone", "other"] },
              "value": { "$ref": "#/definitions/nonEmptyString" }
            }
          }
        },
        "roles": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "organizer",
              "host",
              "invitee",
              "attendee",
              "speaker",
              "note_taker",
              "bot"
            ]
          }
        },
        "response_status": {
          "enum": ["accepted", "declined", "tentative", "unknown"]
        },
        "attendance": { "enum": ["attended", "no_show", "unknown"] },
        "organization": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": { "$ref": "#/definitions/nonEmptyString" },
            "domain": { "$ref": "#/definitions/nonEmptyString" }
          }
        },
        "is_external": { "type": "boolean" },
        "metadata": { "$ref": "#/definitions/jsonObject" }
      }
    },
    "meetingContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "participants"],
      "properties": {
        "id": { "$ref": "#/definitions/nonEmptyString" },
        "title": { "$ref": "#/definitions/nonEmptyString" },
        "time": { "$ref": "#/definitions/meetingTime" },
        "participants": {
          "type": "array",
          "items": { "$ref": "#/definitions/meetingParticipant" }
        }
      }
    },
    "signalManifestItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["signal_id", "kind", "position_within_kind", "sha256"],
      "properties": {
        "signal_id": { "$ref": "#/definitions/signalId" },
        "kind": { "enum": ["decision", "action", "rationale"] },
        "position_within_kind": { "type": "integer", "minimum": 0 },
        "sha256": { "$ref": "#/definitions/digest" }
      }
    },
    "approvalGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "brief_schema_version",
        "brief_id",
        "approved_brief_sha256",
        "signal_manifest"
      ],
      "properties": {
        "brief_schema_version": { "const": 1 },
        "brief_id": { "$ref": "#/definitions/nonEmptyString" },
        "approved_brief_sha256": { "$ref": "#/definitions/digest" },
        "signal_manifest": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/signalManifestItem" }
        }
      }
    },
    "record": {
      "oneOf": [
        { "$ref": "#/definitions/decisionRecord" },
        { "$ref": "#/definitions/actionRecord" },
        { "$ref": "#/definitions/rationaleRecord" }
      ]
    },
    "decisionRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_id",
        "kind",
        "signal_id",
        "signal",
        "meeting_context",
        "approval_group"
      ],
      "properties": {
        "record_id": { "$ref": "#/definitions/recordId" },
        "kind": { "const": "decision" },
        "signal_id": { "$ref": "#/definitions/signalId" },
        "signal": { "$ref": "#/definitions/decisionSignal" },
        "meeting_context": { "$ref": "#/definitions/meetingContext" },
        "approval_group": { "$ref": "#/definitions/approvalGroup" }
      }
    },
    "actionRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_id",
        "kind",
        "signal_id",
        "signal",
        "meeting_context",
        "approval_group"
      ],
      "properties": {
        "record_id": { "$ref": "#/definitions/recordId" },
        "kind": { "const": "action" },
        "signal_id": { "$ref": "#/definitions/signalId" },
        "signal": { "$ref": "#/definitions/actionSignal" },
        "meeting_context": { "$ref": "#/definitions/meetingContext" },
