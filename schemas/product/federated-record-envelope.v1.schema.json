        "observed_at"
      ],
      "properties": {
        "surface": { "const": "cli" },
        "installation_id": { "$ref": "#/definitions/installationId" },
        "reviewer_label": { "$ref": "#/definitions/nonEmptyString" },
        "command": { "const": "approve" },
        "observed_at": { "$ref": "#/definitions/timestamp" }
      }
    },
    "cliApproval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface",
        "approver",
        "raw_actor_assertion",
        "assurance",
        "reviewed_at",
        "reason",
        "approved_brief_sha256",
        "approved_context_sha256",
        "observed_by"
      ],
      "properties": {
        "surface": { "type": "null" },
        "approver": {
          "type": "object",
          "additionalProperties": false,
          "required": ["principal_id", "membership_id", "claim_id"],
          "properties": {
            "principal_id": { "$ref": "#/definitions/principalId" },
            "membership_id": { "$ref": "#/definitions/membershipId" },
            "claim_id": { "type": "null" }
          }
        },
        "raw_actor_assertion": { "$ref": "#/definitions/cliRawActor" },
        "assurance": { "const": "installation_holder_self_attested" },
        "reviewed_at": { "$ref": "#/definitions/timestamp" },
        "reason": {
          "oneOf": [
            { "$ref": "#/definitions/nonEmptyString" },
            { "type": "null" }
          ]
        },
        "approved_brief_sha256": { "$ref": "#/definitions/digest" },
        "approved_context_sha256": { "$ref": "#/definitions/digest" },
        "observed_by": { "$ref": "#/definitions/productArtifact" }
      }
    },
    "approval": {
      "oneOf": [
        { "$ref": "#/definitions/slackApproval" },
        { "$ref": "#/definitions/cliApproval" }
      ]
    },
    "retention": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "indefinite" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "days"],
          "properties": {
            "kind": { "const": "duration" },
            "days": { "type": "integer", "minimum": 1 }
          }
        }
      ]
    },
    "publicationSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_id",
        "version",
        "policy_sha256",
        "identity_manifest_id",
        "signer_installation_id",
        "signer_key_id",
        "payload_scope",
        "audience",
        "sensitivity",
        "retention",
        "raw_meeting_content",
        "participant_observations"
      ],
      "properties": {
        "policy_id": { "$ref": "#/definitions/policyId" },
        "version": { "type": "integer", "minimum": 1 },
        "policy_sha256": { "$ref": "#/definitions/digest" },
        "identity_manifest_id": { "$ref": "#/definitions/manifestId" },
        "signer_installation_id": { "$ref": "#/definitions/installationId" },
        "signer_key_id": { "$ref": "#/definitions/digest" },
        "payload_scope": {
          "const": "approved-signal-with-meeting-context-brief-digest-and-bounded-evidence"
        },
        "audience": {
          "type": "object",
          "additionalProperties": false,
          "required": ["scope", "subjects"],
          "properties": {
            "scope": { "enum": ["organization", "named-subjects"] },
            "subjects": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "$ref": "#/definitions/owner" }
            }
          }
        },
        "sensitivity": { "enum": ["internal", "confidential", "restricted"] },
        "retention": { "$ref": "#/definitions/retention" },
        "raw_meeting_content": { "const": "local-only" },
        "participant_observations": {
          "enum": ["included-namespaced", "excluded"]
        }
      }
    },
    "jsonObject": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": { "^.*$": { "$ref": "#/definitions/jsonValue" } }
    },
    "jsonValue": {
      "oneOf": [
        { "type": "null" },
        { "type": "boolean" },
        { "type": "number" },
        { "type": "string" },
        { "type": "array", "items": { "$ref": "#/definitions/jsonValue" } },
        { "$ref": "#/definitions/jsonObject" }
      ]
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
