      "properties": {
        "record_id": { "$ref": "#/definitions/recordId" },
        "kind": { "const": "rationale" },
        "signal_id": { "$ref": "#/definitions/signalId" },
        "signal": { "$ref": "#/definitions/rationaleSignal" },
        "meeting_context": { "$ref": "#/definitions/meetingContext" },
        "approval_group": { "$ref": "#/definitions/approvalGroup" }
      }
    },
    "slackProviderIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "team_id",
        "enterprise_id",
        "bot_user_id",
        "bot_id",
        "app_id"
      ],
      "properties": {
        "provider": { "const": "slack" },
        "team_id": { "$ref": "#/definitions/nonEmptyString" },
