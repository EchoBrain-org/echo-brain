{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://echo.local/schemas/product/organization-enrollment-challenge.v1.schema.json",
  "title": "ECHO organization enrollment challenge",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "challenge_id",
    "authority_id",
    "organization_id",
    "principal_id",
    "membership_id",
    "installation_id",
    "installation_key_id",
    "identity_manifest_id",
    "identity_manifest_sha256",
    "publication_policy_id",
    "publication_policy_version",
    "publication_policy_sha256",
    "nonce_base64",
    "issued_at",
    "expires_at",
    "integrity"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "echo-organization-enrollment-challenge" },
    "challenge_id": { "$ref": "#/definitions/challengeId" },
    "authority_id": { "$ref": "#/definitions/authorityId" },
    "organization_id": { "$ref": "#/definitions/organizationId" },
    "principal_id": { "$ref": "#/definitions/principalId" },
    "membership_id": { "$ref": "#/definitions/membershipId" },
    "installation_id": { "$ref": "#/definitions/installationId" },
    "installation_key_id": { "$ref": "#/definitions/digest" },
    "identity_manifest_id": { "$ref": "#/definitions/manifestId" },
    "identity_manifest_sha256": { "$ref": "#/definitions/digest" },
    "publication_policy_id": { "$ref": "#/definitions/policyId" },
    "publication_policy_version": { "type": "integer", "minimum": 1 },
    "publication_policy_sha256": { "$ref": "#/definitions/digest" },
    "nonce_base64": { "$ref": "#/definitions/base64" },
    "issued_at": { "$ref": "#/definitions/timestamp" },
    "expires_at": { "$ref": "#/definitions/timestamp" },
    "integrity": { "$ref": "#/definitions/integrity" }
  },
  "definitions": {
    "challengeId": {
      "type": "string",
      "pattern": "^ech_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "authorityId": {
      "type": "string",
      "pattern": "^oau_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "organizationId": {
      "type": "string",
      "pattern": "^org_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "principalId": {
      "type": "string",
      "pattern": "^prn_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "membershipId": {
      "type": "string",
      "pattern": "^mem_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "installationId": {
      "type": "string",
      "pattern": "^ins_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "manifestId": {
      "type": "string",
      "pattern": "^idm_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "policyId": {
      "type": "string",
      "pattern": "^pol_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "timestamp": {
      "type": "string",
      "format": "utc-millisecond-timestamp",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$"
    },
    "base64": {
      "type": "string",
      "minLength": 4,
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonicalization",
        "payload_sha256",
        "signature_algorithm",
        "key_id",
        "signature_base64"
      ],
      "properties": {
        "canonicalization": { "const": "RFC8785" },
        "payload_sha256": { "$ref": "#/definitions/digest" },
        "signature_algorithm": { "const": "ecdsa-p256-sha256-der-low-s" },
        "key_id": { "$ref": "#/definitions/digest" },
        "signature_base64": { "$ref": "#/definitions/base64" }
      }
    }
  }
}
