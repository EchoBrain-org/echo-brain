{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://echo.local/schemas/product/active-identity-bundle.v1.schema.json",
  "title": "ECHO active identity bundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "manifest",
    "connection_registry",
    "default_publication_policy",
    "active_installation_id",
    "activated_at",
    "activation_reason",
    "integrity"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "echo-active-identity-bundle" },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest_id", "path", "sha256"],
      "properties": {
        "manifest_id": { "$ref": "#/definitions/manifestId" },
        "path": {
          "type": "string",
          "pattern": "^manifests/identity-manifest\\.idm_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}\\.v1\\.json$"
        },
        "sha256": { "$ref": "#/definitions/digest" }
      }
    },
    "connection_registry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["registry_id", "revision", "path", "sha256"],
      "properties": {
        "registry_id": { "$ref": "#/definitions/registryId" },
        "revision": { "type": "integer", "minimum": 1 },
        "path": {
          "type": "string",
          "pattern": "^registries/connection-registry\\.reg_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}\\.r[1-9][0-9]*\\.v1\\.json$"
        },
        "sha256": { "$ref": "#/definitions/digest" }
      }
    },
    "default_publication_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_id", "version", "path", "sha256"],
      "properties": {
        "policy_id": { "$ref": "#/definitions/policyId" },
        "version": { "type": "integer", "minimum": 1 },
        "path": {
          "type": "string",
          "pattern": "^policies/publication-policy\\.pol_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}\\.v[1-9][0-9]*\\.json$"
        },
        "sha256": { "$ref": "#/definitions/digest" }
      }
    },
    "active_installation_id": { "$ref": "#/definitions/installationId" },
    "activated_at": { "$ref": "#/definitions/timestamp" },
    "activation_reason": {
      "enum": ["founder-bootstrap", "installation-reenrollment", "bundle-update"]
    },
    "integrity": { "$ref": "#/definitions/integrity" }
  },
  "definitions": {
    "manifestId": {
      "type": "string",
      "pattern": "^idm_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "registryId": {
      "type": "string",
      "pattern": "^reg_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "policyId": {
      "type": "string",
      "pattern": "^pol_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "installationId": {
      "type": "string",
      "pattern": "^ins_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "timestamp": {
      "type": "string",
      "format": "utc-millisecond-timestamp",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$"
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonicalization",
        "payload_sha256",
        "signature_algorithm",
        "key_id",
        "signature_base64"
      ],
      "properties": {
        "canonicalization": { "const": "RFC8785" },
        "payload_sha256": { "$ref": "#/definitions/digest" },
        "signature_algorithm": { "const": "ecdsa-p256-sha256-der-low-s" },
        "key_id": { "$ref": "#/definitions/digest" },
        "signature_base64": { "$ref": "#/definitions/base64" }
      }
    },
    "base64": {
      "type": "string",
      "minLength": 4,
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
    }
  }
}
