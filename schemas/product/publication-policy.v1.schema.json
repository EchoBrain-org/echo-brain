{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://echo.local/schemas/product/publication-policy.v1.schema.json",
  "title": "ECHO publication policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "policy_id",
    "organization_id",
    "identity_manifest_id",
    "issued_by",
    "version",
    "effective_at",
    "publication",
    "integrity"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "echo-publication-policy" },
    "policy_id": { "$ref": "#/definitions/policyId" },
    "organization_id": { "$ref": "#/definitions/organizationId" },
    "identity_manifest_id": { "$ref": "#/definitions/manifestId" },
    "issued_by": {
      "type": "object",
      "additionalProperties": false,
      "required": ["installation_id", "key_id"],
      "properties": {
        "installation_id": { "$ref": "#/definitions/installationId" },
        "key_id": { "$ref": "#/definitions/digest" }
      }
    },
    "version": { "type": "integer", "minimum": 1 },
    "effective_at": { "$ref": "#/definitions/timestamp" },
    "publication": { "$ref": "#/definitions/publication" },
    "integrity": { "$ref": "#/definitions/integrity" }
  },
  "definitions": {
    "policyId": {
      "type": "string",
      "pattern": "^pol_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "organizationId": {
      "type": "string",
      "pattern": "^org_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "membershipId": {
      "type": "string",
      "pattern": "^mem_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "manifestId": {
      "type": "string",
      "pattern": "^idm_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "installationId": {
      "type": "string",
      "pattern": "^ins_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "timestamp": {
      "type": "string",
      "format": "utc-millisecond-timestamp",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$"
    },
    "base64": {
      "type": "string",
      "minLength": 4,
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
    },
    "owner": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "id"],
          "properties": {
            "kind": { "const": "organization" },
            "id": { "$ref": "#/definitions/organizationId" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "id"],
          "properties": {
            "kind": { "const": "membership" },
            "id": { "$ref": "#/definitions/membershipId" }
          }
        }
      ]
    },
    "retention": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "indefinite" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "days"],
          "properties": {
            "kind": { "const": "duration" },
            "days": { "type": "integer", "minimum": 1 }
          }
        }
      ]
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "payload_scope",
        "audience",
        "sensitivity",
        "retention",
        "raw_meeting_content",
        "participant_observations"
      ],
      "properties": {
        "payload_scope": {
          "const": "approved-signal-with-meeting-context-brief-digest-and-bounded-evidence"
        },
        "audience": {
          "type": "object",
          "additionalProperties": false,
          "required": ["scope", "subjects"],
          "properties": {
            "scope": { "enum": ["organization", "named-subjects"] },
            "subjects": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "$ref": "#/definitions/owner" }
            }
          }
        },
        "sensitivity": { "enum": ["internal", "confidential", "restricted"] },
        "retention": { "$ref": "#/definitions/retention" },
        "raw_meeting_content": { "const": "local-only" },
        "participant_observations": {
          "enum": ["included-namespaced", "excluded"]
        }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonicalization",
        "payload_sha256",
        "signature_algorithm",
        "key_id",
        "signature_base64"
      ],
      "properties": {
        "canonicalization": { "const": "RFC8785" },
        "payload_sha256": { "$ref": "#/definitions/digest" },
        "signature_algorithm": { "const": "ecdsa-p256-sha256-der-low-s" },
        "key_id": { "$ref": "#/definitions/digest" },
        "signature_base64": { "$ref": "#/definitions/base64" }
      }
    }
  }
}
