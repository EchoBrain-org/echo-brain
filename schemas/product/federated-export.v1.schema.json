{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://echo.local/schemas/product/federated-export.v1.schema.json",
  "title": "ECHO signed federated export manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "export_id",
    "organization_id",
    "installation_id",
    "key_id",
    "signing_identity_manifest_id",
    "artifacts",
    "sequence",
    "records",
    "generated_at",
    "integrity"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "echo-federated-export" },
    "export_id": { "$ref": "#/definitions/exportId" },
    "organization_id": { "$ref": "#/definitions/organizationId" },
    "installation_id": { "$ref": "#/definitions/installationId" },
    "key_id": { "$ref": "#/definitions/digest" },
    "signing_identity_manifest_id": { "$ref": "#/definitions/manifestId" },
    "artifacts": {
      "type": "array",
      "minItems": 2,
      "allOf": [
        {
          "contains": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "kind", "sha256"],
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^identity-manifests/identity-manifest\\.idm_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}\\.v1\\.json$"
              },
              "kind": { "const": "echo-local-identity-manifest" },
              "sha256": { "$ref": "#/definitions/digest" }
            }
          }
        },
        {
          "contains": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "kind", "sha256"],
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^publication-policies/publication-policy\\.pol_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}\\.v[1-9][0-9]*\\.json$"
              },
              "kind": { "const": "echo-publication-policy" },
              "sha256": { "$ref": "#/definitions/digest" }
            }
          }
        }
      ],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "kind", "sha256"],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^(?:identity-manifests/identity-manifest\\.idm_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}\\.v1\\.json|publication-policies/publication-policy\\.pol_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}\\.v[1-9][0-9]*\\.json)$"
          },
          "kind": {
            "enum": ["echo-local-identity-manifest", "echo-publication-policy"]
          },
          "sha256": { "$ref": "#/definitions/digest" }
        }
      }
    },
    "sequence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["first", "last", "predecessor_hash", "head_hash"],
      "properties": {
        "first": { "type": "integer", "minimum": 1 },
        "last": { "type": "integer", "minimum": 1 },
        "predecessor_hash": {
          "oneOf": [{ "$ref": "#/definitions/digest" }, { "type": "null" }]
        },
        "head_hash": { "$ref": "#/definitions/digest" }
      }
    },
    "records": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "count", "sha256"],
      "properties": {
        "path": { "const": "records.v1.jsonl" },
        "count": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/definitions/digest" }
      }
    },
    "generated_at": { "$ref": "#/definitions/timestamp" },
    "integrity": { "$ref": "#/definitions/integrity" }
  },
  "definitions": {
    "exportId": {
      "type": "string",
      "pattern": "^exp_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "organizationId": {
      "type": "string",
      "pattern": "^org_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "installationId": {
      "type": "string",
      "pattern": "^ins_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "manifestId": {
      "type": "string",
      "pattern": "^idm_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "timestamp": {
      "type": "string",
      "format": "utc-millisecond-timestamp",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$"
    },
    "base64": {
      "type": "string",
      "minLength": 4,
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonicalization",
        "payload_sha256",
        "signature_algorithm",
        "key_id",
        "signature_base64"
      ],
      "properties": {
        "canonicalization": { "const": "RFC8785" },
        "payload_sha256": { "$ref": "#/definitions/digest" },
        "signature_algorithm": { "const": "ecdsa-p256-sha256-der-low-s" },
        "key_id": { "$ref": "#/definitions/digest" },
        "signature_base64": { "$ref": "#/definitions/base64" }
      }
    }
  }
}
