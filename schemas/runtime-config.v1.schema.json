{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://echo.local/schemas/product/runtime-config.v1.schema.json",
  "title": "ECHO Brain runtime configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "lane",
    "state_dir",
    "meeting_sources",
    "decision_processor",
    "communication_channels",
    "approval_mode"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "lane": { "const": "team-product" },
    "state_dir": { "type": "string", "minLength": 2, "pattern": "^/" },
    "meeting_sources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/adapterInstance" }
    },
    "decision_processor": { "$ref": "#/definitions/adapterInstance" },
    "communication_channels": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/adapterInstance" }
    },
    "cycle_interval_ms": {
      "type": "integer",
      "minimum": 1000,
      "maximum": 3600000
    },
    "extraction_timeout_ms": {
      "type": "integer",
      "minimum": 1000,
      "maximum": 600000
    },
    "approval_mode": { "enum": ["manual", "adapter"] },
    "approval_surface": { "$ref": "#/definitions/adapterInstance" }
  },
  "allOf": [
    {
      "if": { "properties": { "approval_mode": { "const": "adapter" } } },
      "then": { "required": ["approval_surface"] }
    },
    {
      "if": { "properties": { "approval_mode": { "const": "manual" } } },
      "then": { "not": { "required": ["approval_surface"] } }
    }
  ],
  "definitions": {
    "adapterInstance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter_id", "instance_id", "settings"],
      "properties": {
        "adapter_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "instance_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "credential_ref": { "$ref": "#/definitions/secretReference" },
        "settings": { "type": "object" }
      }
    },
    "secretReference": {
      "type": "string",
      "pattern": "^(env:[A-Za-z][A-Za-z0-9_.-]*|file:/[^\\u0000]+)$"
    }
  }
}
