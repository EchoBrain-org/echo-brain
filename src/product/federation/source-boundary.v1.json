{
  "boundary_version": 1,
  "kind": "echo-workspace-source-boundary",
  "name": "echo-brain/stable-federation",
  "workspace": false,
  "boundary_root": "src/product/federation",
  "source_root": "src/product/federation",
  "entry_points": [
    "src/product/federation/bootstrap/identity-check.ts",
    "src/product/federation/cutover-fence.ts",
    "src/product/federation/identity/active-identity-bundle-store.ts"
  ],
  "owned_source_paths": ["src/product/federation/**"],
  "allowed_internal_paths": [
    "src/product/federation/**",
    "src/core/**",
    "src/adapters/decision-processors/llm/llm-decision-processor.ts",
    "src/adapters/meeting-sources/granola/index.ts",
    "src/adapters/shared/slack/slack-web-api-client.ts",
    "src/infrastructure/filesystem/atomic-create.ts",
    "src/infrastructure/filesystem/atomic-write.ts",
    "src/product/config.ts",
    "src/product/credentials.ts",
    "src/product/machine/security/**",
    "src/product/paths.ts",
    "src/product/secure-local-files.ts",
    "src/util/json.ts"
  ],
  "allowed_workspace_packages": ["@echo-brain/federation-protocol"],
  "allowed_external_packages": ["ajv"],
  "allowed_node_builtins": ["crypto", "fs", "path"],
  "runtime_assets": [],
  "layer_rules": [
    {
      "name": "stable-federation-stays-inside-its-local-trust-boundary",
      "from": "src/product/federation/**",
      "allowed_imports": [
        "src/product/federation/**",
        "src/core/**",
        "src/adapters/decision-processors/llm/llm-decision-processor.ts",
        "src/adapters/meeting-sources/granola/index.ts",
        "src/adapters/shared/slack/slack-web-api-client.ts",
        "src/infrastructure/filesystem/atomic-create.ts",
        "src/infrastructure/filesystem/atomic-write.ts",
        "src/product/config.ts",
        "src/product/credentials.ts",
        "src/product/machine/security/**",
        "src/product/paths.ts",
        "src/product/secure-local-files.ts",
        "src/util/json.ts"
      ],
      "allowed_workspace_packages": ["@echo-brain/federation-protocol"],
      "allowed_external_packages": ["ajv"],
      "allowed_node_builtins": ["crypto", "fs", "path"]
    }
  ]
}
