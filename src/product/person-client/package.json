    "@echo-brain/federation-protocol",
    "@echo-brain/organization-protocol",
    "@echo-brain/organization-api"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean"
  },
  "dependencies": {
    "@echo-brain/federation-protocol": "0.0.0-dev.0",
    "@echo-brain/organization-api": "0.0.0-dev.0",
    "@echo-brain/organization-protocol": "0.0.0-dev.0"
  },
  "engines": {
    "node": "22.22.1",
    "npm": "10.9.4"
  }
