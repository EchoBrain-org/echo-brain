{
  "name": "@echo-brain/person-client",
  "version": "0.1.0-internal.1",
  "private": true,
  "description": "Thin Person-authenticated client for an organization-operated ECHO Authority",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
