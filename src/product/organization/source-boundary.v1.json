      "allowed_workspace_packages": [
        "@echo-brain/federation-protocol",
        "@echo-brain/organization-protocol"
      ],
      "allowed_external_packages": [],
      "allowed_node_builtins": []
    },
    {
      "name": "local-enrollment-composes-client-and-state",
      "from": "src/product/organization/enrollment/**",
      "allowed_imports": [
        "src/product/organization/enrollment/**",
        "src/product/organization/client/**",
        "src/product/organization/state/**",
        "src/product/federation/**",
        "src/product/secure-local-files.ts"
      ],
      "allowed_workspace_packages": [
        "@echo-brain/federation-protocol",
        "@echo-brain/organization-protocol",
        "@echo-brain/organization-api"
      ],
      "allowed_external_packages": [],
      "allowed_node_builtins": ["node:crypto"]
    }
  ]
