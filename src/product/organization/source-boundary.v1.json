      "allowed_workspace_packages": [
        "@echo-brain/federation-protocol",
        "@echo-brain/organization-protocol",
        "@echo-brain/organization-api"
      ],
      "allowed_external_packages": [],
      "allowed_node_builtins": []
    },
    {
      "name": "local-organization-composition-wires-stable-modules",
      "from": "src/product/organization/composition.ts",
      "allowed_imports": [
        "src/product/organization/**",
        "src/product/machine/security/installation-signer.ts"
      ],
      "allowed_workspace_packages": [
        "@echo-brain/federation-protocol",
        "@echo-brain/organization-protocol",
        "@echo-brain/organization-api"
      ],
      "allowed_external_packages": [],
      "allowed_node_builtins": []
    },
    {
      "name": "local-organization-client-uses-public-api",
      "from": "src/product/organization/client/**",
      "allowed_imports": ["src/product/organization/client/**"],
      "allowed_workspace_packages": [
        "@echo-brain/organization-protocol",
        "@echo-brain/organization-api"
      ],
      "allowed_external_packages": [],
