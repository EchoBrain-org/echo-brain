    "src/product/paths.ts",
    "src/product/secure-local-files.ts",
    "src/infrastructure/filesystem/**"
  ],
  "forbidden_repository_roots": [
    "src/experimental/n2/",
    "services/",
    "packages/"
  ],
  "allowed_workspace_packages": [
    "@echo-brain/federation-protocol",
    "@echo-brain/organization-protocol",
    "@echo-brain/organization-api"
  ],
  "allowed_external_packages": [],
  "allowed_node_builtins": ["node:buffer", "node:crypto"],
  "runtime_assets": [],
  "layer_rules": [
    {
      "name": "local-organization-public-entry",
      "from": "src/product/organization/index.ts",
      "allowed_imports": ["src/product/organization/**"],
      "allowed_workspace_packages": [
        "@echo-brain/federation-protocol",
        "@echo-brain/organization-protocol",
        "@echo-brain/organization-api"
      ],
      "allowed_external_packages": [],
      "allowed_node_builtins": []
    },
    {
      "name": "local-organization-composition-wires-stable-modules",
      "from": "src/product/organization/composition.ts",
      "allowed_imports": [
        "src/product/organization/**",
        "src/product/federation/**",
        "src/product/storage/**",
        "src/product/paths.ts",
        "src/product/secure-local-files.ts",
        "src/infrastructure/filesystem/**"
      ],
      "allowed_workspace_packages": [
        "@echo-brain/federation-protocol",
        "@echo-brain/organization-protocol",
        "@echo-brain/organization-api"
      ],
      "allowed_external_packages": [],
      "allowed_node_builtins": []
    },
    {
      "name": "local-organization-client-uses-public-api",
      "from": "src/product/organization/client/**",
      "allowed_imports": ["src/product/organization/client/**"],
      "allowed_workspace_packages": [
        "@echo-brain/organization-protocol",
        "@echo-brain/organization-api"
      ],
      "allowed_external_packages": [],
      "allowed_node_builtins": ["node:buffer"]
