{
  "boundary_version": 1,
  "kind": "echo-workspace-source-boundary",
  "name": "@echo-brain/organization-record",
  "workspace": true,
  "boundary_root": "services/organization-record",
  "source_root": "services/organization-record/src",
  "package_json": "services/organization-record/package.json",
  "entry_points": [
    "services/organization-record/src/organization-record-api-v1.ts"
  ],
  "owned_source_paths": [
    "services/organization-record/src/**"
  ],
  "allowed_internal_paths": [
    "services/organization-record/src/**"
  ],
  "allowed_workspace_packages": [
    "@echo-brain/federation-protocol"
  ],
  "allowed_external_packages": [
    "better-sqlite3"
  ],
  "allowed_node_builtins": [
    "fs",
    "path"
  ],
  "runtime_assets": [
    "services/organization-record/baselines/organization-record-derived-baseline-v1.sql",
    "services/organization-record/baselines/organization-record-log-baseline-v1.sql",
    "services/organization-record/baselines/organization-record-log-baseline-v2.sql"
  ],
  "component_index_contract": {
    "canonical_components": [
      {
        "name": "Organization Record public API",
        "path": "services/organization-record/src/organization-record-api-v1.ts",
        "export": "OrganizationRecordAppenderV4"
      },
      {
        "name": "Organization Record database",
        "path": "services/organization-record/src/persistence/open-organization-record-database.ts",
        "export": "openOrganizationRecordDatabase"
      },
      {
        "name": "V4 organization record appender",
        "path": "services/organization-record/src/log/record-log-v4-append.ts",
        "export": "OrganizationRecordAppenderV4"
      },
      {
        "name": "Permission-aware Person record reader",
        "path": "services/organization-record/src/retrieve/person-record-reader-v1.ts",
        "export": "PersonRecordReaderV1"
      },
      {
        "name": "Record retrieval-source snapshot",
        "path": "services/organization-record/src/retrieve/record-retrieval-source-snapshot-v1.ts",
        "export": "RecordRetrievalSourceSnapshotPortV1"
      },
      {
        "name": "Private Slack Block approval policy projector",
        "path": "services/organization-record/src/adapters/record-policy-projection/slack/private-slack-block-approval-policy-projector-v1.ts",
        "export": "createPrivateSlackBlockApprovalPolicyProjectorV1"
      }
    ],
    "retired_source_paths": [
      "services/organization-record/src/organization-record-service-v1.ts",
      "services/organization-record/src/organization-record-runtime-v1.ts",
      "services/organization-record/src/persistence/open-unmigrated-database.ts",
      "services/organization-record/src/retrieve/clean-person-record-reader-v1.ts",
      "services/organization-record/src/retrieve/clean-v4-layer1-snapshot.ts"
    ],
    "compatibility_entrypoints": [
      {
        "path": "services/organization-record/src/new-lineage-v1.ts",
        "targets": [
          "services/organization-record/src/organization-record-api-v1.ts"
        ]
      }
    ]
  },
  "layer_rules": [
    {
      "name": "record-entrypoint-exports-public-api",
      "from": "services/organization-record/src/*.ts",
      "allowed_imports": [
        "services/organization-record/src/**"
      ],
      "allowed_workspace_packages": [],
      "allowed_external_packages": [],
      "allowed_node_builtins": []
    },
    {
      "name": "record-application-is-pure",
      "from": "services/organization-record/src/application/**",
      "allowed_imports": [
        "services/organization-record/src/application/**"
      ],
      "allowed_workspace_packages": [
        "@echo-brain/federation-protocol"
      ],
      "allowed_external_packages": [],
      "allowed_node_builtins": []
    },
    {
      "name": "record-persistence-owns-sqlite",
      "from": "services/organization-record/src/persistence/**",
      "allowed_imports": [
        "services/organization-record/src/persistence/**"
      ],
      "allowed_workspace_packages": [
        "@echo-brain/federation-protocol"
      ],
      "allowed_external_packages": [
        "better-sqlite3"
      ],
      "allowed_node_builtins": [
        "fs",
        "path"
      ]
    },
    {
      "name": "record-log-appends-through-application-contracts",
      "from": "services/organization-record/src/log/**",
      "allowed_imports": [
        "services/organization-record/src/application/**",
        "services/organization-record/src/log/**",
        "services/organization-record/src/persistence/**"
      ],
      "allowed_workspace_packages": [
        "@echo-brain/federation-protocol"
      ],
      "allowed_external_packages": [
        "better-sqlite3"
      ],
      "allowed_node_builtins": []
    },
    {
      "name": "record-retrieval-readers-use-only-v4-facts",
      "from": "services/organization-record/src/retrieve/**",
      "allowed_imports": [
        "services/organization-record/src/application/**",
        "services/organization-record/src/retrieve/**"
      ],
      "allowed_workspace_packages": [
        "@echo-brain/federation-protocol"
      ],
      "allowed_external_packages": [
        "better-sqlite3"
      ],
      "allowed_node_builtins": []
    },
    {
      "name": "record-adapters-implement-provider-specific-projectors",
      "from": "services/organization-record/src/adapters/**",
      "allowed_imports": [
        "services/organization-record/src/adapters/**",
        "services/organization-record/src/application/**"
      ],
      "allowed_workspace_packages": [
        "@echo-brain/federation-protocol"
      ],
      "allowed_external_packages": [],
      "allowed_node_builtins": []
    }
  ]
}
