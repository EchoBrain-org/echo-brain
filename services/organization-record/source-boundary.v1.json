{
  "boundary_version": 1,
  "kind": "echo-workspace-source-boundary",
  "name": "@echo-brain/organization-record",
  "workspace": true,
  "boundary_root": "services/organization-record",
  "source_root": "services/organization-record/src",
  "package_json": "services/organization-record/package.json",
  "entry_points": [
    "services/organization-record/src/new-lineage-v1.ts"
  ],
  "owned_source_paths": [
    "services/organization-record/src/**"
  ],
  "allowed_internal_paths": [
    "services/organization-record/src/**"
  ],
  "allowed_workspace_packages": [
    "@echo-brain/federation-protocol"
  ],
  "allowed_external_packages": [
    "better-sqlite3"
  ],
  "allowed_node_builtins": [
    "fs",
    "path"
  ],
  "runtime_assets": [
    "services/organization-record/baselines/organization-record-derived-baseline-v1.sql",
    "services/organization-record/baselines/organization-record-log-baseline-v1.sql",
    "services/organization-record/baselines/organization-record-log-baseline-v2.sql"
  ],
  "layer_rules": [
    {
      "name": "record-entrypoint-exports-public-api",
      "from": "services/organization-record/src/*.ts",
      "allowed_imports": [
        "services/organization-record/src/**"
      ],
      "allowed_workspace_packages": [],
      "allowed_external_packages": [],
      "allowed_node_builtins": []
    },
    {
      "name": "record-application-is-pure",
      "from": "services/organization-record/src/application/**",
      "allowed_imports": [
        "services/organization-record/src/application/**"
      ],
      "allowed_workspace_packages": [
        "@echo-brain/federation-protocol"
      ],
      "allowed_external_packages": [],
      "allowed_node_builtins": []
    },
    {
      "name": "record-persistence-owns-sqlite",
      "from": "services/organization-record/src/persistence/**",
      "allowed_imports": [
        "services/organization-record/src/persistence/**"
      ],
      "allowed_workspace_packages": [
        "@echo-brain/federation-protocol"
      ],
      "allowed_external_packages": [
        "better-sqlite3"
      ],
      "allowed_node_builtins": [
        "fs",
        "path"
      ]
    },
    {
      "name": "record-log-appends-through-application-contracts",
      "from": "services/organization-record/src/log/**",
      "allowed_imports": [
        "services/organization-record/src/application/**",
        "services/organization-record/src/log/**",
        "services/organization-record/src/persistence/**"
      ],
      "allowed_workspace_packages": [
        "@echo-brain/federation-protocol"
      ],
      "allowed_external_packages": [
        "better-sqlite3"
      ],
      "allowed_node_builtins": []
    },
    {
      "name": "record-clean-readers-use-only-v4-facts",
      "from": "services/organization-record/src/retrieve/**",
      "allowed_imports": [
        "services/organization-record/src/application/**",
        "services/organization-record/src/retrieve/**"
      ],
      "allowed_workspace_packages": [
        "@echo-brain/federation-protocol"
      ],
      "allowed_external_packages": [
        "better-sqlite3"
      ],
      "allowed_node_builtins": []
    }
  ]
}
