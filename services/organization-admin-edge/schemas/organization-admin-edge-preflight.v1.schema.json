{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://echo.local/schemas/organization-admin-edge/organization-admin-edge-preflight.v1.schema.json",
  "title": "ECHO organization administrator edge preflight result",
  "oneOf": [
    { "$ref": "#/definitions/success" },
    { "$ref": "#/definitions/releasePlatformFailure" },
    { "$ref": "#/definitions/localCandidateFailure" }
  ],
  "definitions": {
    "success": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "kind",
        "ok",
        "release_platform_qualified",
        "declared_platform",
        "observed_platform",
        "listener",
        "public_origin",
        "employee_authority_base_url",
        "authority_origin",
        "allowed_admin_client_count",
        "checked_at",
        "server_certificate_not_before",
        "server_certificate_not_after",
        "client_ca_certificate_count"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "kind": { "const": "echo-organization-admin-edge-preflight" },
        "ok": { "const": true },
        "release_platform_qualified": { "const": true },
        "declared_platform": { "$ref": "#/definitions/declaredPlatform" },
        "observed_platform": { "$ref": "#/definitions/observedPlatform" },
        "listener": { "$ref": "#/definitions/listener" },
        "public_origin": { "$ref": "#/definitions/httpsOrigin" },
        "employee_authority_base_url": {
          "$ref": "#/definitions/httpsOrigin"
        },
        "authority_origin": { "$ref": "#/definitions/httpOrigin" },
        "allowed_admin_client_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        },
        "checked_at": { "$ref": "#/definitions/timestamp" },
        "server_certificate_not_before": {
          "$ref": "#/definitions/timestamp"
        },
        "server_certificate_not_after": {
          "$ref": "#/definitions/timestamp"
        },
        "client_ca_certificate_count": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "releasePlatformFailure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "kind",
        "ok",
        "release_platform_qualified",
        "declared_platform",
        "observed_platform",
        "failed_check"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "kind": { "const": "echo-organization-admin-edge-preflight" },
        "ok": { "const": false },
        "release_platform_qualified": { "const": false },
        "declared_platform": { "$ref": "#/definitions/declaredPlatform" },
        "observed_platform": { "$ref": "#/definitions/observedPlatform" },
        "failed_check": { "const": "release_platform" }
      }
    },
    "localCandidateFailure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "kind",
        "ok",
        "release_platform_qualified",
        "declared_platform",
        "observed_platform",
        "failed_check"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "kind": { "const": "echo-organization-admin-edge-preflight" },
        "ok": { "const": false },
        "release_platform_qualified": { "const": true },
        "declared_platform": { "$ref": "#/definitions/declaredPlatform" },
        "observed_platform": { "$ref": "#/definitions/observedPlatform" },
        "failed_check": {
          "enum": [
            "runtime_config",
            "runtime_material",
            "server_certificate_parse",
            "server_certificate_hostname",
            "server_certificate_purpose",
            "server_certificate_not_yet_valid",
            "server_certificate_expired",
            "server_private_key_parse",
            "server_private_key_mismatch",
            "client_ca_or_tls_context"
          ]
        }
      }
    },
    "declaredPlatform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "architecture", "node", "npm"],
      "properties": {
        "os": { "const": "darwin" },
        "architecture": { "const": "arm64" },
        "node": { "const": "22.22.1" },
        "npm": { "const": "10.9.4" }
      }
    },
    "observedPlatform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "architecture", "node"],
      "properties": {
        "os": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[a-z0-9_+-]+$"
        },
        "architecture": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[a-z0-9_+-]+$"
        },
        "node": {
          "type": "string",
          "minLength": 5,
          "maxLength": 64,
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
        }
      }
    },
    "listener": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "port"],
      "properties": {
        "host": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "anyOf": [
            {
              "pattern": "^[0-9]{1,3}(?:\\.[0-9]{1,3}){3}$"
            },
            {
              "pattern": "^[0-9A-Fa-f:.]*:[0-9A-Fa-f:.]*(?:%[0-9A-Za-z_.-]+)?$"
            }
          ]
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "httpsOrigin": {
      "type": "string",
      "minLength": 9,
      "maxLength": 2048,
      "pattern": "^https://[^\\s/@?#]+$"
    },
    "httpOrigin": {
      "type": "string",
      "minLength": 8,
      "maxLength": 2048,
      "pattern": "^http://(?:127\\.0\\.0\\.1|\\[::1\\])(?::[0-9]{1,5})?$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    }
  }
}
