{
  "name": "@echo-brain/organization-retrieval",
  "version": "0.0.0-dev.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./build": {
      "types": "./dist/build.d.ts",
      "import": "./dist/build.js"
    },
    "./serve": {
      "types": "./dist/serve.d.ts",
      "import": "./dist/serve.js"
    }
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "migrations/**"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "test": "npm run build && vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@echo-brain/federation-protocol": "0.0.0-dev.0",
    "better-sqlite3": "12.10.0"
  },
  "engines": {
    "node": "22.22.1",
    "npm": "10.9.4"
  }
}
