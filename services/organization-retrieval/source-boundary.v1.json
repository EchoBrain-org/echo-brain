      "allowed_imports": [
        "services/organization-retrieval/src/**"
      ],
      "allowed_workspace_packages": [
        "@echo-brain/federation-protocol"
      ],
      "allowed_external_packages": [
        "better-sqlite3"
      ],
      "allowed_node_builtins": [
        "crypto",
        "fs",
        "path"
      ]
    },
    {
      "name": "retrieval-compatibility-entrypoint-is-thin",
      "from": "services/organization-retrieval/src/new-lineage-v1.ts",
      "allowed_imports": [
        "services/organization-retrieval/src/readable-search-runtime-v1.ts"
      ],
      "allowed_workspace_packages": [],
      "allowed_external_packages": [],
      "allowed_node_builtins": []
    },
    {
      "name": "retrieval-application-is-pure",
      "from": "services/organization-retrieval/src/application/**",
      "allowed_imports": [
        "services/organization-retrieval/src/application/**"
      ],
      "allowed_workspace_packages": [
        "@echo-brain/federation-protocol"
      ],
      "allowed_external_packages": [],
      "allowed_node_builtins": []
    },
    {
      "name": "retrieval-persistence-owns-sqlite",
      "from": "services/organization-retrieval/src/persistence/**",
      "allowed_imports": [
        "services/organization-retrieval/src/application/**",
        "services/organization-retrieval/src/persistence/**"
      ],
      "allowed_workspace_packages": [
        "@echo-brain/federation-protocol"
      ],
      "allowed_external_packages": [
        "better-sqlite3"
      ],
      "allowed_node_builtins": [
        "crypto",
        "fs",
        "path"
      ]
    }
  ]
}
