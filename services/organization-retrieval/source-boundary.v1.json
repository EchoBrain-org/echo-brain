{
  "boundary_version": 1,
  "kind": "echo-workspace-source-boundary",
  "name": "@echo-brain/organization-retrieval",
  "workspace": true,
  "boundary_root": "services/organization-retrieval",
  "source_root": "services/organization-retrieval/src",
  "package_json": "services/organization-retrieval/package.json",
  "entry_points": [
    "services/organization-retrieval/src/readable-search-runtime-v1.ts"
  ],
  "owned_source_paths": [
    "services/organization-retrieval/src/**"
  ],
  "allowed_internal_paths": [
    "services/organization-retrieval/src/**"
  ],
  "allowed_workspace_packages": [
    "@echo-brain/federation-protocol"
  ],
  "allowed_external_packages": [
    "better-sqlite3"
  ],
  "allowed_node_builtins": [
    "crypto",
    "fs",
    "path"
  ],
  "runtime_assets": [
    "services/organization-retrieval/baselines/readable-search-facts-baseline-v1.sql",
    "services/organization-retrieval/baselines/readable-search-lexical-baseline-v1.sql",
    "services/organization-retrieval/baselines/readable-search-content-baseline-v1.sql"
  ],
  "forbidden_repository_roots": [
    "services/organization-authority",
    "services/organization-record",
    "services/organization-control-plane"
  ],
  "layer_rules": [
    {
      "name": "readable-search-runtime-v1-owns-generation-composition",
