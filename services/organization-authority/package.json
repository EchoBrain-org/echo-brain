{
  "name": "@echo-brain/organization-authority",
  "version": "0.0.0-dev.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "dist/main.js",
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "import": "./dist/main.js"
    },
    "./processing/core/*.js": {
      "types": "./dist/processing/core/*.d.ts",
      "import": "./dist/processing/core/*.js"
    },
    "./processing/adapters/decision-processors/*.js": {
      "types": "./dist/processing/adapters/decision-processors/*.d.ts",
      "import": "./dist/processing/adapters/decision-processors/*.js"
    },
    "./processing/adapters/meeting-sources/*.js": {
      "types": "./dist/processing/adapters/meeting-sources/*.d.ts",
      "import": "./dist/processing/adapters/meeting-sources/*.js"
    },
    "./processing/adapters/approval-surfaces/*.js": {
      "types": "./dist/processing/adapters/approval-surfaces/*.d.ts",
      "import": "./dist/processing/adapters/approval-surfaces/*.js"
    },
    "./processing/adapters/delivery-surfaces/*.js": {
      "types": "./dist/processing/adapters/delivery-surfaces/*.d.ts",
      "import": "./dist/processing/adapters/delivery-surfaces/*.js"
    },
    "./processing/authorization/*.js": {
      "types": "./dist/processing/authorization/*.d.ts",
      "import": "./dist/processing/authorization/*.js"
    },
    "./processing/approval/*.js": {
      "types": "./dist/processing/approval/*.d.ts",
      "import": "./dist/processing/approval/*.js"
    }
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "migrations/**"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "test": "npm run build && vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@echo-brain/federation-protocol": "0.0.0-dev.0",
    "@echo-brain/organization-control-plane": "0.0.0-dev.0",
    "@echo-brain/organization-protocol": "0.0.0-dev.0",
    "@echo-brain/organization-api": "0.0.0-dev.0",
    "@echo-brain/organization-record": "0.0.0-dev.0",
    "@echo-brain/organization-retrieval": "0.0.0-dev.0",
    "better-sqlite3": "12.10.0"
  },
  "engines": {
    "node": "22.22.1",
    "npm": "10.9.4"
  }
}
