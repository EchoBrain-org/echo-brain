    "./new-lineage-v1": {
      "types": "./dist/new-lineage-v1.d.ts",
      "import": "./dist/new-lineage-v1.js"
    },
    "./clean-runtime-v1": {
      "types": "./dist/clean-runtime-v1.d.ts",
      "import": "./dist/clean-runtime-v1.js"
    },
    "./new-lineage-genesis-v1": {
      "types": "./dist/new-lineage-genesis-v1.d.ts",
      "import": "./dist/new-lineage-genesis-v1.js"
    },
    "./clean-slack-identity-v1": {
      "types": "./dist/clean-slack-identity-v1.d.ts",
