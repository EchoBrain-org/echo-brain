{
  "extends": "./tsconfig.build.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "types": ["node", "vitest/globals"]
  },
  "include": [
    "src/**/*.ts",
    "tests/migration/**/*.ts",
    "tests/standalone/**/*.ts",
    "tests/core/**/*.ts",
    "tests/adapters/**/*.ts",
    "tests/infrastructure/**/*.ts",
    "tests/product/**/*.ts",
    "vitest.config.ts",
    "vitest.product.config.ts"
  ]
}
