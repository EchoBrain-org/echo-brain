{
  "extends": "./tsconfig.build.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "types": ["node", "vitest/globals"]
  },
  "include": [
    "packages/*/test/**/*.ts",
    "services/*/test/**/*.ts",
    "tests/**/*.ts",
    "vitest.config.ts",
    "vitest.package.config.ts"
  ]
}
