{
  "extends": "./tsconfig.build.json",
  "compilerOptions": {
    "noEmit": true,
    "allowJs": true,
    "rootDir": ".",
    "types": [
      "node",
      "vitest/globals"
    ]
  },
  "include": [
    "packages/*/test/**/*.ts",
    "services/*/test/**/*.ts",
    "tests/**/*.ts",
    "vitest.config.ts",
    "providers/**/test/**/*.ts"
  ]
}
