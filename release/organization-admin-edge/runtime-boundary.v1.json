{
  "schema_version": 1,
  "kind": "echo-runtime-release-boundary",
  "target": "organization-admin-edge",
  "package": "@echo-brain/organization-admin-edge",
  "source_boundary": "services/organization-admin-edge/source-boundary.v1.json",
  "entrypoint": "dist/main.js",
  "launcher": "bin/echo-organization-admin-edge.mjs",
  "bundled_workspace_packages": [
    "@echo-brain/federation-protocol",
    "@echo-brain/organization-protocol",
    "@echo-brain/organization-api"
  ],
  "external_runtime_packages": [],
  "declared_platform": {
    "os": "darwin",
    "architecture": "arm64",
    "node": "22.22.1",
    "npm": "10.9.4"
  },
  "mutable_state": {
    "packaged": false,
    "owned_paths": [
      "secret-free administrator edge runtime config",
      "public TLS certificate chain",
      "private TLS key",
      "trusted administrator client CA material",
      "authority trusted-proxy credential file",
      "operator-owned logs and service-supervisor state"
    ],
    "rule": "Certificates, credentials, configuration, logs, and supervisor state must live outside the immutable installation prefix."
  }
}
