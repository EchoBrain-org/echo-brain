{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "echo-brain/provenance/source-extraction.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["extraction_version", "reviewed_spec_sha", "source_sha", "target_commit", "entries"],
  "properties": {
    "extraction_version": { "const": 1 },
    "reviewed_spec_sha": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "source_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "target_commit": { "type": ["string", "null"], "pattern": "^[0-9a-f]{40}$" },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["target_path", "git_mode", "target_sha256", "origin"],
        "properties": {
          "target_path": { "type": "string" },
          "git_mode": { "type": "string", "enum": ["100644", "100755"] },
          "target_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "origin": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind"],
            "properties": {
              "kind": { "type": "string", "enum": ["copied", "relocated", "target-only"] },
              "source_path": { "type": "string" },
              "source_blob_oid": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
              "transform": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
