{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "echo-brain/provenance/dependency-toolchain.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["toolchain_version", "node", "npm", "runtime_lock", "lifecycle_hooks", "allowed_package_scripts", "javascript_clis", "system_helpers"],
  "properties": {
    "toolchain_version": { "const": 1 },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "absolute_path"],
      "properties": {
        "version": { "const": "22.22.1" },
        "absolute_path": { "const": "/usr/local/bin/node" }
      }
    },
    "npm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version"],
      "properties": {
        "version": { "const": "10.9.4" }
      }
    },
    "runtime_lock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "sha256", "packages"],
      "properties": {
        "file": { "const": "npm-shrinkwrap.json" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "packages": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "version", "integrity"],
            "properties": {
              "name": { "type": "string" },
              "version": { "type": "string" },
              "integrity": { "type": "string" }
            }
          }
        }
      }
    },
    "lifecycle_hooks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["package", "version", "hook"],
        "properties": {
          "package": { "type": "string" },
          "version": { "type": "string" },
          "hook": { "type": "string", "enum": ["preinstall", "install", "postinstall", "prepare"] }
        }
      }
    },
    "allowed_package_scripts": {
      "type": "array",
      "items": { "type": "string" }
    },
    "javascript_clis": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "version", "integrity"],
        "properties": {
          "name": { "type": "string" },
          "version": { "type": "string" },
          "integrity": { "type": "string" }
        }
      }
    },
    "build_inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "version", "integrity"],
        "properties": {
          "name": { "type": "string" },
          "version": { "type": "string" },
          "integrity": { "type": "string" }
        }
      }
    },
    "computed_command_owners": {
      "type": "array",
      "items": { "type": "string" }
    },
    "lint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cli", "cli_version", "config_name", "config_sha256", "invocation", "committed_to_target"],
      "properties": {
        "cli": { "type": "string" },
        "cli_version": { "type": "string" },
        "config_name": { "type": "string" },
        "config_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "invocation": { "type": "string" },
        "committed_to_target": { "const": false }
      }
    },
    "system_helpers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "absolute_path"],
        "properties": {
          "name": { "type": "string" },
          "absolute_path": { "type": "string", "pattern": "^/" }
        }
      }
    }
  }
}
