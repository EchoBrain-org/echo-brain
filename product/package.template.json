{
  "name": "echo-brain",
  "version": "0.0.0-dev.0",
  "description": "DEV-only standalone ECHO meeting-to-decision product candidate",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "dist/product/index.js",
  "types": "dist/product/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/product/index.d.ts",
      "import": "./dist/product/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./adapters": {
      "types": "./dist/adapters/index.d.ts",
      "import": "./dist/adapters/index.js"
    },
    "./adapters/meeting-sources/granola": {
      "types": "./dist/adapters/meeting-sources/granola/index.d.ts",
      "import": "./dist/adapters/meeting-sources/granola/index.js"
    },
    "./adapters/decision-processors/structured-text": {
      "types": "./dist/adapters/decision-processors/structured-text/index.d.ts",
      "import": "./dist/adapters/decision-processors/structured-text/index.js"
    },
    "./adapters/decision-processors/llm": {
      "types": "./dist/adapters/decision-processors/llm/index.d.ts",
      "import": "./dist/adapters/decision-processors/llm/index.js"
    },
    "./adapters/communication-channels/jsonl-outbox": {
      "types": "./dist/adapters/communication-channels/jsonl-outbox/index.d.ts",
      "import": "./dist/adapters/communication-channels/jsonl-outbox/index.js"
    },
    "./adapters/approval-surfaces/slack-reactions": {
      "types": "./dist/adapters/approval-surfaces/slack-reactions/index.d.ts",
      "import": "./dist/adapters/approval-surfaces/slack-reactions/index.js"
    },
    "./schemas/meeting-context.v1.schema.json": "./schemas/meeting-context.v1.schema.json",
    "./schemas/runtime-config.v1.schema.json": "./schemas/runtime-config.v1.schema.json"
  },
  "bin": {
    "echo-brain": "dist/product/cli.js"
  },
  "engines": {
    "node": "22.22.1",
    "npm": "10.9.4"
  },
  "files": [
    "dist/**",
    "schemas/meeting-context.v1.schema.json",
    "schemas/runtime-config.v1.schema.json",
    "npm-shrinkwrap.json",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "ajv": "8.20.0",
    "better-sqlite3": "12.10.0"
  }
}
