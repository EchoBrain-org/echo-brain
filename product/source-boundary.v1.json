{
  "boundary_version": 1,
  "entry_points": [
    "src/product/cli.ts",
    "src/product/index.ts",
    "src/core/index.ts",
    "src/adapters/index.ts",
    "src/adapters/meeting-sources/granola/index.ts",
    "src/adapters/decision-processors/structured-text/index.ts",
    "src/adapters/decision-processors/llm/index.ts",
    "src/adapters/delivery-surfaces/jsonl-outbox/index.ts",
    "src/adapters/delivery-surfaces/slack/index.ts",
    "src/adapters/approval-surfaces/slack-reactions/index.ts",
    "src/product/organization/index.ts"
  ],
  "allowed_internal_paths": [
    "src/product/**",
    "src/core/**",
    "src/adapters/**",
    "src/infrastructure/filesystem/atomic-write.ts",
    "src/infrastructure/filesystem/atomic-create.ts",
    "src/infrastructure/sqlite/migrate.ts",
    "src/util/json.ts",
    "src/infrastructure/filesystem/process-file-lock.ts"
  ],
  "forbidden_internal_roots": [
    "src/daemon/",
    "src/mcp/",
    "src/coord/",
    "src/trace/",
    "src/surfaces/ceo-slack-responder/",
    "src/cli/commands/orchestration.ts"
  ],
  "removed_internal_roots": [
    "src/experimental/",
    "src/capture/",
    "src/storage/",
    "src/echo-home/",
    "src/enrich/",
    "src/adapters/meeting-sources/granola/compatibility/",
    "src/adapters/communication-channels/"
  ],
  "allowed_external_runtime_packages": [
    "@echo-brain/federation-protocol",
    "@echo-brain/organization-api",
    "@echo-brain/organization-protocol",
    "ajv",
    "better-sqlite3"
  ],
  "runtime_assets": [
    "schemas/meeting-context.v1.schema.json",
    "schemas/runtime-config.v1.schema.json",
    "schemas/product/active-identity-bundle.v1.schema.json",
    "schemas/product/local-identity-manifest.v1.schema.json",
    "schemas/product/local-connection-registry.v1.schema.json",
    "schemas/product/publication-policy.v1.schema.json",
    "schemas/product/source-attribution.v1.schema.json",
    "schemas/product/processor-attribution.v1.schema.json",
    "schemas/product/approval-federation-metadata.v1.schema.json",
    "schemas/product/federated-record-envelope.v1.schema.json",
    "schemas/product/federated-export.v1.schema.json",
    "src/product/storage/migrations/0001_initial.sql",
    "src/product/storage/migrations/0002_core_state.sql",
    "src/product/storage/migrations/0003_federated_founder_identity.sql",
    "src/product/storage/migrations/0004_remove_legacy_events.sql",
    "src/product/storage/migrations/0005_organization_access.sql",
    "src/product/storage/migrations/0006_organization_authority_connection.sql",
    "src/product/storage/migrations/0007_organization_authority_rebind.sql"
  ],
  "layer_rules": [
    {
      "name": "core-is-tool-agnostic",
      "from": "src/core/**",
      "allowed_imports": ["src/core/**"],
      "allowed_packages": [],
      "allowed_node_builtins": ["crypto"]
    },
    {
      "name": "adapters-depend-on-contracts-and-narrow-infrastructure",
      "from": "src/adapters/**",
      "allowed_imports": [
        "src/adapters/**",
        "src/core/**",
        "src/infrastructure/filesystem/process-file-lock.ts"
      ],
      "allowed_packages": [],
      "allowed_node_builtins": [
        "crypto",
        "fs",
        "fs/promises",
        "path",
        "readline"
      ]
    },
    {
      "name": "infrastructure-is-product-independent",
      "from": "src/infrastructure/**",
      "allowed_imports": ["src/infrastructure/**"],
      "allowed_packages": ["better-sqlite3"],
      "allowed_node_builtins": ["crypto", "fs", "fs/promises", "path"]
    },
    {
      "name": "product-storage-implements-core-ports",
      "from": "src/product/storage/**",
      "allowed_imports": [
        "src/product/storage/**",
        "src/core/**",
        "src/infrastructure/sqlite/**"
      ],
      "allowed_packages": ["better-sqlite3"],
      "allowed_node_builtins": ["fs", "path", "url"]
    },
    {
      "name": "machine-security-owns-os-key-lifecycle",
      "from": "src/product/machine/**",
      "allowed_imports": [
        "src/product/machine/**",
        "src/product/secure-local-files.ts",
        "src/infrastructure/filesystem/atomic-create.ts"
      ],
      "allowed_packages": ["@echo-brain/federation-protocol"],
      "allowed_node_builtins": ["crypto", "fs", "path"]
    },
    {
      "name": "llm-provider-drivers-own-only-transport",
      "from": "src/adapters/decision-processors/llm/*-client.ts",
      "allowed_imports": [
        "src/core/**",
        "src/adapters/decision-processors/llm/llm-provider.ts"
      ],
      "allowed_packages": [],
      "allowed_node_builtins": []
    },
    {
      "name": "granola-canonical-adapter-avoids-compatibility",
      "from": "src/adapters/meeting-sources/granola/meeting-source-adapter.ts",
      "allowed_imports": [
        "src/core/**",
        "src/adapters/meeting-sources/granola/granola-api-client.ts"
      ],
      "allowed_packages": [],
      "allowed_node_builtins": ["crypto"]
    },
    {
      "name": "product-root-composes-the-runtime",
      "from": "src/product/*.ts",
      "allowed_imports": [
        "src/product/*.ts",
        "src/product/approval/**",
        "src/product/federation/**",
        "src/product/machine/**",
        "src/product/organization/**",
        "src/product/storage/**",
        "src/core/**",
        "src/adapters/**",
        "src/infrastructure/**",
        "src/util/**"
      ],
      "allowed_packages": ["ajv", "better-sqlite3"],
      "allowed_node_builtins": [
        "child_process",
        "crypto",
        "fs",
        "module",
        "os",
        "path",
        "stream",
        "url",
        "util"
      ]
    },
    {
      "name": "federation-owns-local-identity-and-the-cutover-fence",
      "from": "src/product/federation/**",
      "allowed_imports": [
        "src/product/*.ts",
        "src/product/approval/**",
        "src/product/federation/**",
        "src/product/machine/**",
        "src/product/storage/**",
        "src/core/**",
        "src/adapters/**",
        "src/infrastructure/**",
        "src/util/**"
      ],
      "allowed_packages": [
        "@echo-brain/federation-protocol",
        "ajv",
        "better-sqlite3"
      ],
      "allowed_node_builtins": ["crypto", "fs", "path", "url"]
    },
    {
      "name": "organization-client-speaks-only-the-authority-protocols",
      "from": "src/product/organization/**",
      "allowed_imports": [
        "src/product/organization/**",
        "src/product/machine/**",
        "src/product/storage/**",
        "src/product/secure-local-files.ts"
      ],
      "allowed_packages": [
        "@echo-brain/federation-protocol",
        "@echo-brain/organization-api",
        "@echo-brain/organization-protocol"
      ],
      "allowed_node_builtins": ["buffer", "crypto", "fs", "https", "path"]
    },
    {
      "name": "approval-gates-use-the-local-identity-fence",
      "from": "src/product/approval/**",
      "allowed_imports": [
        "src/product/approval/**",
        "src/product/federation/**",
        "src/core/**",
        "src/infrastructure/**",
        "src/util/**"
      ],
      "allowed_packages": [],
      "allowed_node_builtins": ["crypto", "fs", "path"]
    },
    {
      "name": "util-is-leaf-shared-code",
      "from": "src/util/**",
      "allowed_imports": [],
      "allowed_packages": [],
      "allowed_node_builtins": ["fs"]
    }
  ],
  "adapter_architecture": {
    "core_root": "src/core/**",
    "adapters_root": "src/adapters/",
    "forbid_discovered_adapter_ids_in_core": true
  },
  "child_process_owner": "src/product/spawn-sanitized-child.ts"
}
