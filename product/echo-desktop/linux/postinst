#!/bin/bash
# The ECHO deb's postinst, which dpkg runs as root (ADR-0035). This is
# electron-builder 26's after-install template written out for /opt/ECHO, with
# one change: chrome-sandbox is never made setuid root. electron-builder copies
# this file unchanged, since it has no template macros. The update feed refuses
# a deb whose postinst differs from this file at the release commit.

if type update-alternatives >/dev/null 2>&1; then
    # Remove previous link if it doesn't use update-alternatives
    if [ -L '/usr/bin/echo-desktop' -a -e '/usr/bin/echo-desktop' -a "`readlink '/usr/bin/echo-desktop'`" != '/etc/alternatives/echo-desktop' ]; then
        rm -f '/usr/bin/echo-desktop'
    fi
    update-alternatives --install '/usr/bin/echo-desktop' 'echo-desktop' '/opt/ECHO/echo-desktop' 100 || ln -sf '/opt/ECHO/echo-desktop' '/usr/bin/echo-desktop'
else
    ln -sf '/opt/ECHO/echo-desktop' '/usr/bin/echo-desktop'
fi

# Chromium sandboxes with unprivileged user namespaces. Ubuntu 24.04 allows
# them through the AppArmor profile below, and older Ubuntu and Debian allow
# them by default. A system that forbids them cannot start the app; this never
# falls back to a setuid-root sandbox.
chmod 0755 '/opt/ECHO/chrome-sandbox' || true

if hash update-mime-database 2>/dev/null; then
    update-mime-database /usr/share/mime || true
fi

if hash update-desktop-database 2>/dev/null; then
    update-desktop-database /usr/share/applications || true
fi

# Install the AppArmor profile (Ubuntu 24.04 and later) when this AppArmor
# supports it. Ubuntu 22.04 lacks abi/4.0 and runs the app without it. The
# profile is linux/apparmor-profile, which the update feed also binds.
if apparmor_status --enabled > /dev/null 2>&1; then
  APPARMOR_PROFILE_SOURCE='/opt/ECHO/resources/apparmor-profile'
  APPARMOR_PROFILE_TARGET='/etc/apparmor.d/echo-desktop'
  if apparmor_parser --skip-kernel-load --debug "$APPARMOR_PROFILE_SOURCE" > /dev/null 2>&1; then
    cp -f "$APPARMOR_PROFILE_SOURCE" "$APPARMOR_PROFILE_TARGET"

    # Loading the profile is not meaningful in a chroot, such as an image build.
    if ! { [ -x '/usr/bin/ischroot' ] && /usr/bin/ischroot; } && hash apparmor_parser 2>/dev/null; then
      apparmor_parser --replace --write-cache --skip-read-cache "$APPARMOR_PROFILE_TARGET"
    fi
  else
    echo "Skipping the installation of the AppArmor profile as this version of AppArmor does not seem to support the bundled profile"
  fi
fi
