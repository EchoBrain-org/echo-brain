{
  "name": "echo-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "ECHO desktop app (Electron) for macOS, Windows and Linux",
  "type": "module",
  "main": "build/main.cjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "npm run build && electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && vitest run && playwright test"
  },
  "dependencies": {
    "electron": "44.4.5",
    "preact": "10.29.8"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
