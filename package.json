{
  "name": "echo-brain",
  "version": "0.0.0-dev.0",
  "description": "Tool-agnostic meeting-to-decision core with replaceable source, processor, and delivery adapters",
  "private": true,
  "workspaces": [
    "packages/federation-protocol",
    "packages/organization-protocol",
    "packages/organization-api",
    "services/organization-authority"
  ],
  "license": "MIT",
  "type": "module",
  "main": "dist/product/index.js",
  "types": "dist/product/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/product/index.d.ts",
      "import": "./dist/product/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./adapters": {
      "types": "./dist/adapters/index.d.ts",
      "import": "./dist/adapters/index.js"
    },
    "./adapters/meeting-sources/granola": {
      "types": "./dist/adapters/meeting-sources/granola/index.d.ts",
      "import": "./dist/adapters/meeting-sources/granola/index.js"
    },
    "./adapters/decision-processors/structured-text": {
      "types": "./dist/adapters/decision-processors/structured-text/index.d.ts",
      "import": "./dist/adapters/decision-processors/structured-text/index.js"
    },
    "./adapters/decision-processors/llm": {
      "types": "./dist/adapters/decision-processors/llm/index.d.ts",
      "import": "./dist/adapters/decision-processors/llm/index.js"
    },
    "./adapters/delivery-surfaces/jsonl-outbox": {
      "types": "./dist/adapters/delivery-surfaces/jsonl-outbox/index.d.ts",
      "import": "./dist/adapters/delivery-surfaces/jsonl-outbox/index.js"
    },
    "./adapters/delivery-surfaces/slack": {
      "types": "./dist/adapters/delivery-surfaces/slack/index.d.ts",
      "import": "./dist/adapters/delivery-surfaces/slack/index.js"
    },
    "./adapters/approval-surfaces/slack-reactions": {
      "types": "./dist/adapters/approval-surfaces/slack-reactions/index.d.ts",
      "import": "./dist/adapters/approval-surfaces/slack-reactions/index.js"
    },
    "./organization": {
      "types": "./dist/product/organization/index.d.ts",
      "import": "./dist/product/organization/index.js"
    },
    "./schemas/meeting-context.v1.schema.json": "./schemas/meeting-context.v1.schema.json",
    "./schemas/runtime-config.v1.schema.json": "./schemas/runtime-config.v1.schema.json",
    "./schemas/product/*": "./schemas/product/*"
  },
  "bin": {
    "echo-brain": "dist/product/cli.js"
  },
  "engines": {
    "node": "22.22.1",
    "npm": "10.9.4"
  },
  "files": [
    "dist/**",
    "schemas/meeting-context.v1.schema.json",
    "schemas/runtime-config.v1.schema.json",
    "schemas/product/*.schema.json",
    "docs/architecture/core-and-adapters.md",
    "npm-shrinkwrap.json",
    "README.md",
    "LICENSE"
  ],
  "bundleDependencies": [
    "@echo-brain/federation-protocol",
    "@echo-brain/organization-protocol",
    "@echo-brain/organization-api"
  ],
  "scripts": {
    "clean": "node tools/build.mjs --clean",
    "clean:workspaces": "tsc -b tsconfig.workspaces.json --clean",
    "build": "node tools/build.mjs",
    "build:workspaces": "tsc -b tsconfig.workspaces.json",
    "typecheck": "npm run typecheck:workspaces && tsc --noEmit -p tsconfig.json",
    "typecheck:workspaces": "tsc -b tsconfig.workspaces.json",
    "lint": "eslint . --max-warnings 0",
    "test": "npm run build:workspaces && vitest run --config vitest.config.ts",
    "test:qualification": "vitest run --config vitest.product.config.ts",
    "check:boundary": "node tools/check-boundary.mjs",
    "check:dependencies": "node tools/check-dependencies.mjs",
    "check:provenance": "node tools/check-provenance.mjs && node tools/check-successor-provenance.mjs",
    "product:check-boundary": "node tools/product/check-boundary.mjs",
    "product:prepare-offline-deps": "node tools/product/prepare-offline-deps.mjs",
    "product:build-artifact": "node tools/product/build-artifact.mjs",
    "check": "npm run check:provenance && npm run check:boundary && npm run check:dependencies && npm run typecheck && npm run typecheck:workspaces && npm run lint && npm test && npm run test:qualification",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@echo-brain/federation-protocol": "0.0.0-dev.0",
    "@echo-brain/organization-api": "0.0.0-dev.0",
    "@echo-brain/organization-protocol": "0.0.0-dev.0",
    "ajv": "8.20.0",
    "better-sqlite3": "12.10.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.11",
    "@types/node": "22.15.3",
    "@typescript-eslint/eslint-plugin": "8.60.1",
    "@typescript-eslint/parser": "8.60.1",
    "eslint": "9.39.4",
    "typescript": "5.9.2",
    "vitest": "4.1.10"
  }
}
