{
  "name": "echo-brain",
  "version": "0.1.0-internal.6",
  "description": "ECHO organization Authority and thin Person client monorepo",
  "private": true,
  "packageManager": "npm@10.9.4",
  "workspaces": [
    "packages/federation-protocol",
    "packages/organization-protocol",
    "packages/organization-api",
    "src/product/person-client",
    "services/organization-authority",
    "packages/organization-control-plane",
    "packages/organization-record",
    "packages/organization-retrieval"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "22.22.1",
    "npm": "10.9.4"
  },
  "scripts": {
    "clean": "node tools/build.mjs --clean",
    "build:authority-image": "node tools/build-authority-image.mjs",
    "bundle:authority-staging-host": "node tools/build-authority-staging-host-bundle.mjs",
    "authority:local": "node tools/authority-local.mjs",
    "authority:staging": "node tools/authority-staging.mjs",
    "authority:staging-release": "node tools/authority-staging-release.mjs",
    "authority:staging-onboarding-transfer": "node tools/authority-staging-onboarding-transfer.mjs",
    "profile:authority-deployment": "node tools/clean-v1-runtime-profile.mjs create",
    "profile:clean-v1-runtime": "npm run profile:authority-deployment --",
    "build:echo-overlay": "node tools/build-echo-overlay.mjs",
    "pack:person-client": "node tools/pack-person-client.mjs",
    "bundle:person-client": "node deploy/release/create-offline-person-client-bundle.mjs",
    "kit:person-onboarding": "node deploy/release/create-person-onboarding-kit.mjs",
    "clean:workspaces": "tsc -b tsconfig.workspaces.json --clean",
    "build": "node tools/build.mjs",
    "build:workspaces": "tsc -b tsconfig.workspaces.json",
    "typecheck": "npm run typecheck:workspaces && tsc --noEmit -p tsconfig.json",
    "typecheck:workspaces": "tsc -b tsconfig.workspaces.json",
    "lint": "eslint . --max-warnings 0",
    "test": "npm run build && vitest run --config vitest.config.ts",
    "test:reference-meeting-processing": "npm run build:workspaces && vitest run --config vitest.config.ts services/organization-authority/test/processing/reference",
    "test:meeting-processing-core": "npm run build:workspaces && vitest run --config vitest.config.ts services/organization-authority/test/processing/core",
    "test:meeting-processing-quality": "npm run build:workspaces && vitest run --config vitest.config.ts services/organization-authority/test/quality",
    "test:quality": "npm run test:meeting-processing-quality",
    "eval:synthetic-meetings": "npm run build:workspaces && node services/organization-authority/dist/synthetic-meeting-quality-main.js",
    "eval:synthetic": "npm run eval:synthetic-meetings --",
    "test:architecture": "npm run build:workspaces && vitest run --config vitest.config.ts tests/architecture",
    "test:protocols": "npm run build:workspaces && npm test --workspace @echo-brain/federation-protocol && npm test --workspace @echo-brain/organization-protocol && npm test --workspace @echo-brain/organization-api",
    "test:authority": "npm run build:workspaces && npm test --workspace @echo-brain/organization-authority",
    "test:control-plane": "npm run build:workspaces && npm test --workspace @echo-brain/organization-control-plane",
    "test:record": "npm run build:workspaces && npm test --workspace @echo-brain/organization-record",
    "test:person": "node tools/build.mjs --person-client && vitest run --config vitest.config.ts tests/person-client",
    "check:architecture-boundaries": "node tools/check-architecture-boundaries.mjs",
    "check:boundary": "npm run check:architecture-boundaries",
    "check:docs": "node tools/check-docs.mjs",
    "check:authority-recovery-infrastructure": "node tools/validate-authority-recovery-templates.mjs",
    "check:authority-infrastructure": "node tools/validate-authority-recovery-templates.mjs",
    "check": "npm run check:architecture-boundaries && npm run check:docs && npm run typecheck && npm run lint && npm test"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.11",
    "@types/node": "22.15.3",
    "@typescript-eslint/eslint-plugin": "8.60.1",
    "@typescript-eslint/parser": "8.60.1",
    "eslint": "9.39.4",
    "typescript": "5.9.2",
    "vitest": "4.1.10"
  }
}
