http://{$ECHO_AUTHORITY_HOST:localhost} {
	route {
		@runtime_status path /_echo/runtime-status
		respond @runtime_status 404

		reverse_proxy 127.0.0.1:39479 {
			header_up X-Echo-Proxy-Authorization "Echo-Proxy {$ECHO_PROXY_TOKEN}"
			header_up X-Echo-Authenticated-Client-Id "{$ECHO_PROXY_CLIENT_ID}"
			header_up X-Echo-Proxy-Source-Address "{http.request.remote.host}"
		}
	}
}
