# CloudFormation Guard 3.2.1 policy for the staging Journey Explorer backend.
# The stack may query only the existing staging journey log group and exposes
# no public, cross-account, dashboard, production, or mutation surface.

let all_resources = Resources.*
let functions = Resources.*[ Type == 'AWS::Lambda::Function' ]
let lambda_permissions = Resources.*[ Type == 'AWS::Lambda::Permission' ]
let lambda_urls = Resources.*[ Type == 'AWS::Lambda::Url' ]
let roles = Resources.*[ Type == 'AWS::IAM::Role' ]
let managed_policies = Resources.*[ Type == 'AWS::IAM::ManagedPolicy' ]
let log_groups = Resources.*[ Type == 'AWS::Logs::LogGroup' ]
let dashboards = Resources.*[ Type == 'AWS::CloudWatch::Dashboard' ]
let alarms = Resources.*[ Type == 'AWS::CloudWatch::Alarm' ]
let api_gateway = Resources.*[ Type == /AWS::ApiGateway::.*/ ]
let api_gateway_v2 = Resources.*[ Type == /AWS::ApiGatewayV2::.*/ ]
let cloudfront = Resources.*[ Type == /AWS::CloudFront::.*/ ]
let network = Resources.*[ Type == /AWS::EC2::.*/ ]
let data_or_queue = Resources.*[ Type IN [
    'AWS::DynamoDB::Table',
    'AWS::S3::Bucket',
    'AWS::RDS::DBInstance',
    'AWS::OpenSearchService::Domain',
    'AWS::SQS::Queue',
    'AWS::SNS::Topic'
] ]

rule exact_staging_journey_explorer_inventory {
    let resource_count = count(%all_resources)
    let function_count = count(%functions)
    let role_count = count(%roles)
    let managed_policy_count = count(%managed_policies)
    let log_group_count = count(%log_groups)

    %resource_count == 4
    %function_count == 1
    %role_count == 1
    %managed_policy_count == 1
    %log_group_count == 1
    Resources.JourneyExplorerFunctionLogGroup.Type == 'AWS::Logs::LogGroup'
    Resources.JourneyExplorerExecutionRole.Type == 'AWS::IAM::Role'
    Resources.CustomWidgetJourneyExplorer.Type == 'AWS::Lambda::Function'
    Resources.JourneyExplorerOperatorInvokePolicy.Type == 'AWS::IAM::ManagedPolicy'
}

rule staging_log_group_is_the_only_input {
    Parameters == {
        "StagingLogGroupName": {
            "Type": "String",
            "Default": "/echo-brain/authority/authority-staging.echobrain.org",
            "AllowedValues": [ "/echo-brain/authority/authority-staging.echobrain.org" ],
            "ConstraintDescription": "must be the one owned Authority staging runtime log group"
        }
    }
}

rule no_public_cross_account_or_data_surface {
    %lambda_permissions EMPTY
    %lambda_urls EMPTY
    %dashboards EMPTY
    %alarms EMPTY
    %api_gateway EMPTY
    %api_gateway_v2 EMPTY
    %cloudfront EMPTY
    %network EMPTY
    %data_or_queue EMPTY
}

rule retained_bounded_function_logs {
    Resources.JourneyExplorerFunctionLogGroup.DeletionPolicy == 'Retain'
    Resources.JourneyExplorerFunctionLogGroup.UpdateReplacePolicy == 'Retain'
    Resources.JourneyExplorerFunctionLogGroup.Properties == {
        "LogGroupName": "/echo-brain/authority/staging-journey-explorer-v1",
        "RetentionInDays": 14
    }
}

rule exact_read_only_execution_role {
    Resources.JourneyExplorerExecutionRole.Properties == {
        "Description": "Runs the staging Journey Explorer with exact log-query and self-logging access.",
        "AssumeRolePolicyDocument": {
            "Version": "2012-10-17",
            "Statement": [ {
                "Effect": "Allow",
                "Principal": { "Service": "lambda.amazonaws.com" },
                "Action": "sts:AssumeRole"
            } ]
        },
        "Policies": [ {
            "PolicyName": "staging-journey-explorer-runtime",
            "PolicyDocument": {
                "Version": "2012-10-17",
                "Statement": [
                    {
                        "Sid": "WriteOwnStructuredLogs",
                        "Effect": "Allow",
                        "Action": [ "logs:CreateLogStream", "logs:PutLogEvents" ],
                        "Resource": { "Fn::Sub": "arn:${AWS::Partition}:logs:${AWS::Region}:${AWS::AccountId}:log-group:${JourneyExplorerFunctionLogGroup}:*" }
                    },
                    {
                        "Sid": "QueryExactStagingJourneyLogGroup",
                        "Effect": "Allow",
                        "Action": [ "logs:StartQuery", "logs:GetQueryResults" ],
                        "Resource": [
                            { "Fn::Sub": "arn:${AWS::Partition}:logs:${AWS::Region}:${AWS::AccountId}:log-group:${StagingLogGroupName}" },
                            { "Fn::Sub": "arn:${AWS::Partition}:logs:${AWS::Region}:${AWS::AccountId}:log-group:${StagingLogGroupName}:*" }
                        ]
                    },
                    {
                        "Sid": "CancelTimedOutLogsInsightsQuery",
                        "Effect": "Allow",
                        "Action": "logs:StopQuery",
                        "Resource": "*"
                    }
                ]
            }
        } ]
    }
}

rule bounded_staging_query_function {
    Resources.CustomWidgetJourneyExplorer.DependsOn not exists
    Resources.CustomWidgetJourneyExplorer.Properties.FunctionName == { "Fn::Sub": "customWidget-${AWS::StackName}-journey-explorer" }
    Resources.CustomWidgetJourneyExplorer.Properties.Description == 'Staging-only read-only content-free journey query backend.'
    Resources.CustomWidgetJourneyExplorer.Properties.Runtime == 'nodejs24.x'
    Resources.CustomWidgetJourneyExplorer.Properties.Handler == 'index.handler'
    Resources.CustomWidgetJourneyExplorer.Properties.Architectures == [ 'arm64' ]
    Resources.CustomWidgetJourneyExplorer.Properties.Role == { "Fn::GetAtt": [ "JourneyExplorerExecutionRole", "Arn" ] }
    Resources.CustomWidgetJourneyExplorer.Properties.MemorySize == 256
    Resources.CustomWidgetJourneyExplorer.Properties.Timeout == 20
    Resources.CustomWidgetJourneyExplorer.Properties.ReservedConcurrentExecutions == 2
    Resources.CustomWidgetJourneyExplorer.Properties.LoggingConfig == {
        "LogFormat": "JSON",
        "ApplicationLogLevel": "INFO",
        "SystemLogLevel": "WARN",
        "LogGroup": { "Ref": "JourneyExplorerFunctionLogGroup" }
    }
    Resources.CustomWidgetJourneyExplorer.Properties.Environment == {
        "Variables": {
            "STAGING_JOURNEY_LOG_GROUP_NAME_V1": { "Ref": "StagingLogGroupName" },
            "STAGING_JOURNEY_QUERY_TIMEOUT_MS_V1": "12000"
        }
    }
    Resources.CustomWidgetJourneyExplorer.Properties.Code.ZipFile exists
    Resources.CustomWidgetJourneyExplorer.Properties.Code.S3Bucket not exists
    Resources.CustomWidgetJourneyExplorer.Properties.Code.S3Key not exists
    Resources.CustomWidgetJourneyExplorer.Properties.VpcConfig not exists
    Resources.CustomWidgetJourneyExplorer.Properties.Layers not exists
}

rule operator_policy_invokes_only_this_backend {
    Resources.JourneyExplorerOperatorInvokePolicy.Properties.ManagedPolicyName == { "Fn::Sub": "${AWS::StackName}-journey-explorer-invoke" }
    Resources.JourneyExplorerOperatorInvokePolicy.Properties.Description == 'Lets an approved same-account staging operator invoke only the Journey Explorer backend.'
    Resources.JourneyExplorerOperatorInvokePolicy.Properties.PolicyDocument == {
        "Version": "2012-10-17",
        "Statement": [ {
            "Sid": "InvokeStagingJourneyExplorerOnly",
            "Effect": "Allow",
            "Action": "lambda:InvokeFunction",
            "Resource": { "Fn::GetAtt": [ "CustomWidgetJourneyExplorer", "Arn" ] }
        } ]
    }
    Resources.JourneyExplorerOperatorInvokePolicy.Properties.Roles not exists
    Resources.JourneyExplorerOperatorInvokePolicy.Properties.Users not exists
    Resources.JourneyExplorerOperatorInvokePolicy.Properties.Groups not exists
}
