{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Disposable isolated ARM64 helper for an offline Authority recovery-volume inspection. It has no public address, Authority role, provider access, or general egress. The caller must provide a versioned, checksum-pinned verifier bundle and an unused subnet CIDR in the selected existing VPC.",
  "Parameters": {
    "VpcId": { "Type": "AWS::EC2::VPC::Id" },
    "AvailabilityZone": {
      "Type": "String",
      "AllowedPattern": "^[a-z]{2}(?:-[a-z0-9]+)+-[1-9][0-9]*[a-z]$",
      "ConstraintDescription": "must be the exact Availability Zone selected for the restored EBS volume"
    },
    "HelperSubnetCidr": {
      "Type": "String",
      "AllowedPattern": "^[0-9]{1,3}(?:\\.[0-9]{1,3}){3}/(?:[0-9]|[12][0-9]|3[0-2])$",
      "ConstraintDescription": "must be an unused IPv4 CIDR wholly inside the selected VPC"
    },
    "HelperAmiId": { "Type": "AWS::EC2::Image::Id" },
    "HelperInstanceType": {
      "Type": "String",
      "Default": "t4g.small",
      "AllowedValues": ["t4g.nano", "t4g.small", "t4g.medium"],
      "ConstraintDescription": "must be an ARM64 Graviton instance type"
    },
    "BundleBucketName": {
      "Type": "String",
      "AllowedPattern": "^[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]$",
      "ConstraintDescription": "must name the pre-existing private versioned bundle bucket"
    },
    "BundleObjectKey": {
      "Type": "String",
      "AllowedPattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{1,900}\\.tar\\.gz$",
      "ConstraintDescription": "must be a safe content-addressed .tar.gz object key"
    },
    "BundleObjectVersion": {
      "Type": "String",
      "AllowedPattern": "^[A-Za-z0-9._/+=-]{8,1024}$",
      "ConstraintDescription": "must be a non-null immutable S3 object version ID containing only single-quote-safe S3 version characters"
    },
    "BundleSha256": {
      "Type": "String",
      "AllowedPattern": "^[0-9a-f]{64}$",
      "ConstraintDescription": "must be the SHA-256 of the exact bundle object version"
    },
    "BundleSourceCommit": {
      "Type": "String",
      "AllowedPattern": "^[0-9a-f]{40}$",
      "ConstraintDescription": "must be the reviewed source commit used to create the verifier bundle"
    },
    "S3PrefixListId": {
      "Type": "String",
      "AllowedPattern": "^pl-[0-9a-f]+$",
      "ConstraintDescription": "must be the regional Amazon S3 managed prefix-list ID"
    },
    "OperationId": {
      "Type": "String",
      "AllowedPattern": "^recovery-[a-z0-9][a-z0-9-]{7,63}$",
      "ConstraintDescription": "must uniquely identify this bounded recovery drill"
    },
    "ExpiresAt": {
      "Type": "String",
      "AllowedPattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "ConstraintDescription": "must be the founder-approved UTC cleanup deadline"
    }
  },
  "Resources": {
    "RecoveryHelperSubnet": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": { "Ref": "VpcId" },
        "AvailabilityZone": { "Ref": "AvailabilityZone" },
        "CidrBlock": { "Ref": "HelperSubnetCidr" },
        "MapPublicIpOnLaunch": false,
        "Tags": [
          { "Key": "Application", "Value": "echo-brain" },
          { "Key": "Purpose", "Value": "authority-recovery-drill" },
          { "Key": "OperationId", "Value": { "Ref": "OperationId" } },
          { "Key": "ExpiresAt", "Value": { "Ref": "ExpiresAt" } }
        ]
      }
    },
    "RecoveryHelperRouteTable": {
      "Type": "AWS::EC2::RouteTable",
      "Properties": {
        "VpcId": { "Ref": "VpcId" },
        "Tags": [
          { "Key": "Application", "Value": "echo-brain" },
          { "Key": "Purpose", "Value": "authority-recovery-drill" },
          { "Key": "OperationId", "Value": { "Ref": "OperationId" } },
          { "Key": "ExpiresAt", "Value": { "Ref": "ExpiresAt" } }
        ]
      }
    },
    "RecoveryHelperRouteTableAssociation": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "SubnetId": { "Ref": "RecoveryHelperSubnet" },
        "RouteTableId": { "Ref": "RecoveryHelperRouteTable" }
      }
    },
    "RecoveryHelperSecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "No-ingress recovery helper; HTTPS only to approved AWS endpoints.",
        "VpcId": { "Ref": "VpcId" },
        "SecurityGroupIngress": [],
        "SecurityGroupEgress": [],
        "Tags": [
          { "Key": "Application", "Value": "echo-brain" },
          { "Key": "Purpose", "Value": "authority-recovery-drill" },
          { "Key": "OperationId", "Value": { "Ref": "OperationId" } },
          { "Key": "ExpiresAt", "Value": { "Ref": "ExpiresAt" } }
        ]
      }
    },
    "RecoveryEndpointSecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "SSM interface endpoint ingress from the recovery helper only.",
        "VpcId": { "Ref": "VpcId" },
        "SecurityGroupIngress": [],
        "SecurityGroupEgress": [],
        "Tags": [
          { "Key": "Application", "Value": "echo-brain" },
          { "Key": "Purpose", "Value": "authority-recovery-drill" },
          { "Key": "OperationId", "Value": { "Ref": "OperationId" } },
          { "Key": "ExpiresAt", "Value": { "Ref": "ExpiresAt" } }
        ]
      }
    },
    "RecoveryEndpointIngress": {
      "Type": "AWS::EC2::SecurityGroupIngress",
      "Properties": {
        "GroupId": {
          "Fn::GetAtt": ["RecoveryEndpointSecurityGroup", "GroupId"]
        },
        "IpProtocol": "tcp",
        "FromPort": 443,
        "ToPort": 443,
        "SourceSecurityGroupId": {
          "Fn::GetAtt": ["RecoveryHelperSecurityGroup", "GroupId"]
        },
        "Description": "Recovery helper only"
      }
    },
    "RecoveryEndpointSelfEgress": {
      "Type": "AWS::EC2::SecurityGroupEgress",
      "Properties": {
        "GroupId": {
          "Fn::GetAtt": ["RecoveryEndpointSecurityGroup", "GroupId"]
        },
        "IpProtocol": "tcp",
        "FromPort": 443,
        "ToPort": 443,
        "DestinationSecurityGroupId": {
          "Fn::GetAtt": ["RecoveryEndpointSecurityGroup", "GroupId"]
        },
        "Description": "Suppress default egress with endpoint-group HTTPS only"
      }
    },
    "RecoveryHelperSsmEgress": {
      "Type": "AWS::EC2::SecurityGroupEgress",
      "Properties": {
        "GroupId": { "Fn::GetAtt": ["RecoveryHelperSecurityGroup", "GroupId"] },
        "IpProtocol": "tcp",
        "FromPort": 443,
        "ToPort": 443,
        "DestinationSecurityGroupId": {
          "Fn::GetAtt": ["RecoveryEndpointSecurityGroup", "GroupId"]
        },
        "Description": "Only SSM interface endpoints"
      }
    },
    "RecoveryHelperS3Egress": {
      "Type": "AWS::EC2::SecurityGroupEgress",
      "Properties": {
        "GroupId": { "Fn::GetAtt": ["RecoveryHelperSecurityGroup", "GroupId"] },
        "IpProtocol": "tcp",
        "FromPort": 443,
        "ToPort": 443,
        "DestinationPrefixListId": { "Ref": "S3PrefixListId" },
        "Description": "Only the S3 gateway endpoint path for the pinned bundle"
      }
    },
    "RecoverySsmEndpoint": {
      "Type": "AWS::EC2::VPCEndpoint",
      "Properties": {
        "VpcId": { "Ref": "VpcId" },
        "VpcEndpointType": "Interface",
        "ServiceName": { "Fn::Sub": "com.amazonaws.${AWS::Region}.ssm" },
        "PrivateDnsEnabled": true,
        "SubnetIds": [{ "Ref": "RecoveryHelperSubnet" }],
        "SecurityGroupIds": [
          { "Fn::GetAtt": ["RecoveryEndpointSecurityGroup", "GroupId"] }
        ],
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": "*",
              "Action": "*",
              "Resource": "*"
            }
          ]
        },
        "Tags": [
          { "Key": "OperationId", "Value": { "Ref": "OperationId" } },
          { "Key": "ExpiresAt", "Value": { "Ref": "ExpiresAt" } }
        ]
      }
    },
    "RecoverySsmMessagesEndpoint": {
      "Type": "AWS::EC2::VPCEndpoint",
      "Properties": {
        "VpcId": { "Ref": "VpcId" },
        "VpcEndpointType": "Interface",
        "ServiceName": {
          "Fn::Sub": "com.amazonaws.${AWS::Region}.ssmmessages"
        },
        "PrivateDnsEnabled": true,
        "SubnetIds": [{ "Ref": "RecoveryHelperSubnet" }],
        "SecurityGroupIds": [
          { "Fn::GetAtt": ["RecoveryEndpointSecurityGroup", "GroupId"] }
        ],
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": "*",
              "Action": "*",
              "Resource": "*"
            }
          ]
        },
        "Tags": [
          { "Key": "OperationId", "Value": { "Ref": "OperationId" } },
          { "Key": "ExpiresAt", "Value": { "Ref": "ExpiresAt" } }
        ]
      }
    },
    "RecoveryBundleS3Endpoint": {
      "Type": "AWS::EC2::VPCEndpoint",
      "Properties": {
        "VpcId": { "Ref": "VpcId" },
        "VpcEndpointType": "Gateway",
        "ServiceName": { "Fn::Sub": "com.amazonaws.${AWS::Region}.s3" },
        "RouteTableIds": [{ "Ref": "RecoveryHelperRouteTable" }],
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": "*",
              "Action": "s3:GetObjectVersion",
              "Resource": {
                "Fn::Sub": "arn:${AWS::Partition}:s3:::${BundleBucketName}/${BundleObjectKey}"
              },
              "Condition": {
                "StringEquals": {
                  "aws:PrincipalArn": {
                    "Fn::GetAtt": ["RecoveryHelperRole", "Arn"]
                  },
                  "s3:VersionId": { "Ref": "BundleObjectVersion" }
                }
              }
            }
          ]
        },
        "Tags": [
          { "Key": "OperationId", "Value": { "Ref": "OperationId" } },
          { "Key": "ExpiresAt", "Value": { "Ref": "ExpiresAt" } }
        ]
      }
    },
    "RecoveryHelperRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "Description": "Recovery helper can use SSM and retrieve exactly one immutable offline verifier bundle.",
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": { "Service": "ec2.amazonaws.com" },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "ManagedPolicyArns": [
          {
            "Fn::Sub": "arn:${AWS::Partition}:iam::aws:policy/AmazonSSMManagedInstanceCore"
          }
        ],
        "Policies": [
          {
            "PolicyName": "read-exact-recovery-verifier-bundle",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": "s3:GetObjectVersion",
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:s3:::${BundleBucketName}/${BundleObjectKey}"
                  },
                  "Condition": {
                    "StringEquals": {
                      "s3:VersionId": { "Ref": "BundleObjectVersion" }
                    }
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "RecoveryHelperInstanceProfile": {
      "Type": "AWS::IAM::InstanceProfile",
      "Properties": { "Roles": [{ "Ref": "RecoveryHelperRole" }] }
    },
    "RecoveryHelper": {
      "Type": "AWS::EC2::Instance",
      "DependsOn": [
        "RecoveryHelperRouteTableAssociation",
        "RecoverySsmEndpoint",
        "RecoverySsmMessagesEndpoint",
        "RecoveryBundleS3Endpoint"
      ],
      "Properties": {
        "ImageId": { "Ref": "HelperAmiId" },
        "InstanceType": { "Ref": "HelperInstanceType" },
        "IamInstanceProfile": { "Ref": "RecoveryHelperInstanceProfile" },
        "AvailabilityZone": { "Ref": "AvailabilityZone" },
        "NetworkInterfaces": [
          {
            "DeviceIndex": "0",
            "SubnetId": { "Ref": "RecoveryHelperSubnet" },
            "GroupSet": [
              { "Fn::GetAtt": ["RecoveryHelperSecurityGroup", "GroupId"] }
            ],
            "AssociatePublicIpAddress": false,
            "DeleteOnTermination": true
          }
        ],
        "BlockDeviceMappings": [
          {
            "DeviceName": "/dev/xvda",
            "Ebs": {
              "Encrypted": true,
              "DeleteOnTermination": true,
              "VolumeType": "gp3"
            }
          }
        ],
        "InstanceInitiatedShutdownBehavior": "terminate",
        "MetadataOptions": {
          "HttpTokens": "required",
          "HttpEndpoint": "enabled",
          "HttpPutResponseHopLimit": 1
        },
        "Tags": [
          { "Key": "Application", "Value": "echo-brain" },
          { "Key": "Purpose", "Value": "authority-recovery-drill" },
          { "Key": "OperationId", "Value": { "Ref": "OperationId" } },
          { "Key": "ExpiresAt", "Value": { "Ref": "ExpiresAt" } },
          {
            "Key": "BundleSourceCommit",
            "Value": { "Ref": "BundleSourceCommit" }
          }
        ],
        "UserData": {
          "Fn::Base64": {
            "Fn::Sub": "#!/bin/bash\nset -Eeuo pipefail\ninstall -d -m 0755 /opt/echo-authority-recovery\narchive=/opt/echo-authority-recovery/bundle.tar.gz\naws s3api get-object --bucket '${BundleBucketName}' --key '${BundleObjectKey}' --version-id '${BundleObjectVersion}' \"$archive\" >/dev/null\nprintf '%s  %s\\n' '${BundleSha256}' \"$archive\" | sha256sum -c -\ntar -xzf \"$archive\" -C /opt/echo-authority-recovery\nnode=/opt/echo-authority-recovery/runtime/node\nsource=/opt/echo-authority-recovery/source\nmanifest=\"$source/recovery-helper-bundle.manifest.json\"\ntest -x \"$node\"\ntest -d \"$source/node_modules\"\ntest -f \"$manifest\"\nid ec2-user >/dev/null\npython3 -c 'import sqlite3'\n\"$node\" -e 'const fs=require(\"fs\"); const crypto=require(\"crypto\"); const [m,c,l]=process.argv.slice(1); const x=JSON.parse(fs.readFileSync(m,\"utf8\")); const h=crypto.createHash(\"sha256\").update(fs.readFileSync(l)).digest(\"hex\"); if (x.schema_version!==1 || x.kind!==\"echo-authority-recovery-helper-bundle-v1\" || x.source_commit!==c || x.node_version!==process.version || process.version!==\"v22.22.1\" || x.platform!==\"linux\" || x.architecture!==\"arm64\" || x.npm_shrinkwrap_sha256!==h) process.exit(1);' \"$manifest\" '${BundleSourceCommit}' \"$source/npm-shrinkwrap.json\"\n\"$node\" --check \"$source/tools/verify-authority-recovery.mjs\"\ncd \"$source\"\nrunuser -u ec2-user -- \"$node\" node_modules/vitest/vitest.mjs run --config vitest.config.ts tests/architecture/authority-recovery-verifier.test.ts\ntouch /opt/echo-authority-recovery/.bundle-ready\n"
          }
        }
      }
    }
  },
  "Outputs": {
    "RecoveryHelperInstanceId": {
      "Description": "Disposable isolated helper instance. Attach only the validated restored drill volume as a secondary device.",
      "Value": { "Ref": "RecoveryHelper" }
    },
    "RecoveryHelperAvailabilityZone": {
      "Description": "Exact Availability Zone to pass to the EBS restore metadata.",
      "Value": { "Ref": "AvailabilityZone" }
    },
    "RecoveryHelperSecurityGroupId": {
      "Description": "Helper security group with no ingress and endpoint-only HTTPS egress.",
      "Value": { "Fn::GetAtt": ["RecoveryHelperSecurityGroup", "GroupId"] }
    },
    "BundleReadyPath": {
      "Description": "Helper-local marker created only after checksum verification and offline verifier smoke succeeds.",
      "Value": "/opt/echo-authority-recovery/.bundle-ready"
    }
  }
}
