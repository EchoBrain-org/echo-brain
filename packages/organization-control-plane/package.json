{
  "name": "@echo-brain/organization-control-plane",
  "version": "0.0.0-dev.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "bin": {
    "echo-organization-control-plane-connect-slack": "dist/clean-slack-connect-main.js"
  },
  "exports": {
    "./slack-approval-integration-v1": {
      "types": "./dist/slack-approval-integration-v1.d.ts",
