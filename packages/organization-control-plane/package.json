    },
    "./slack-external-identity-integration-v1": {
      "types": "./dist/slack-external-identity-integration-v1.d.ts",
      "import": "./dist/slack-external-identity-integration-v1.js"
    },
    "./organization-control-database-v1": {
      "types": "./dist/organization-control-database-v1.d.ts",
      "import": "./dist/organization-control-database-v1.js"
    },
    "./record-visibility-policy-contracts-v1": {
      "types": "./dist/record-visibility-policy-contracts-v1.d.ts",
      "import": "./dist/record-visibility-policy-contracts-v1.js"
    },
    "./slack-connection-setup-v1": {
      "types": "./dist/slack-connection-setup-v1.d.ts",
      "import": "./dist/slack-connection-setup-v1.js"
