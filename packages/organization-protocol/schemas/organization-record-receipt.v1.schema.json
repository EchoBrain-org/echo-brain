{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://echo.local/schemas/organization-protocol/organization-record-receipt.v1.schema.json",
  "title": "ECHO organization record receipt",
  "type": "object",
  "additionalProperties": false,
  "$comment": "The signing key is deliberately not restated as a payload field: integrity.key_id carries it, and verification compares that directly with the pinned authority signing key.",
  "required": [
    "schema_version",
    "kind",
    "authority_id",
    "organization_id",
    "envelope_id",
    "envelope_sha256",
    "installation_id",
    "idempotency_key",
    "position",
    "record_hash",
    "recorded_at",
    "integrity"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "echo-organization-record-receipt" },
    "authority_id": { "$ref": "#/definitions/authorityId" },
    "organization_id": { "$ref": "#/definitions/organizationId" },
    "envelope_id": { "$ref": "#/definitions/recordEnvelopeId" },
    "envelope_sha256": { "$ref": "#/definitions/digest" },
    "installation_id": { "$ref": "#/definitions/installationId" },
    "idempotency_key": { "$ref": "#/definitions/idempotencyKey" },
    "position": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "record_hash": { "$ref": "#/definitions/digest" },
    "recorded_at": { "$ref": "#/definitions/timestamp" },
    "integrity": { "$ref": "#/definitions/integrity" }
  },
  "definitions": {
    "authorityId": {
      "type": "string",
      "minLength": 40,
      "maxLength": 40,
      "pattern": "^oau_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "organizationId": {
      "type": "string",
      "minLength": 40,
      "maxLength": 40,
      "pattern": "^org_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "installationId": {
      "type": "string",
      "minLength": 40,
      "maxLength": 40,
      "pattern": "^ins_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "recordEnvelopeId": {
      "type": "string",
      "minLength": 40,
      "maxLength": 40,
      "pattern": "^rec_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "idempotencyKey": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "digest": {
      "type": "string",
      "minLength": 71,
      "maxLength": 71,
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "minLength": 24,
      "maxLength": 24,
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$"
    },
    "base64": {
      "type": "string",
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonicalization",
        "payload_sha256",
        "signature_algorithm",
        "key_id",
        "signature_base64"
      ],
      "properties": {
        "canonicalization": { "const": "RFC8785" },
        "payload_sha256": { "$ref": "#/definitions/digest" },
        "signature_algorithm": { "const": "ecdsa-p256-sha256-der-low-s" },
        "key_id": { "$ref": "#/definitions/digest" },
        "signature_base64": {
          "type": "string",
          "allOf": [{ "$ref": "#/definitions/base64" }],
          "minLength": 8,
          "maxLength": 96
        }
      }
    }
  }
}
