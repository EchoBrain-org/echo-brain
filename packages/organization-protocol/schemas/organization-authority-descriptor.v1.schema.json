{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://echo.local/schemas/organization-protocol/organization-authority-descriptor.v1.schema.json",
  "title": "ECHO organization authority descriptor",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "authority_id",
    "organization_id",
    "signing_key"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "echo-organization-authority" },
    "authority_id": { "$ref": "#/definitions/authorityId" },
    "organization_id": { "$ref": "#/definitions/organizationId" },
    "signing_key": { "$ref": "#/definitions/p256PublicKey" }
  },
  "definitions": {
    "authorityId": {
      "type": "string",
      "minLength": 40,
      "maxLength": 40,
      "pattern": "^oau_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "organizationId": {
      "type": "string",
      "minLength": 40,
      "maxLength": 40,
      "pattern": "^org_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "digest": {
      "type": "string",
      "minLength": 71,
      "maxLength": 71,
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "base64": {
      "type": "string",
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
    },
    "p256PublicKey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key_id", "algorithm", "public_key_spki_der_base64"],
      "properties": {
        "key_id": { "$ref": "#/definitions/digest" },
        "algorithm": { "const": "ecdsa-p256-sha256-der-low-s" },
        "public_key_spki_der_base64": {
          "type": "string",
          "allOf": [{ "$ref": "#/definitions/base64" }],
          "minLength": 124,
          "maxLength": 124
        }
      }
    }
  }
}
