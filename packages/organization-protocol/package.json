{
  "name": "@echo-brain/organization-protocol",
  "version": "0.0.0-dev.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schemas/organization-authority-descriptor.v1.schema.json": "./schemas/organization-authority-descriptor.v1.schema.json",
    "./record-codec-support-v4": {
      "types": "./dist/record-codec-support-v4.d.ts",
      "import": "./dist/record-codec-support-v4.js"
    }
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "schemas/*.schema.json"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist",
    "prepack": "npm run clean && npm run build",
    "test": "vitest run --root . --config ../../vitest.package.config.ts"
  },
  "dependencies": {
    "@echo-brain/federation-protocol": "0.0.0-dev.0"
  },
  "engines": {
    "node": "22.22.1",
    "npm": "10.9.4"
  }
}
