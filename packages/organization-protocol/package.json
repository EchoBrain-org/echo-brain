{
  "name": "@echo-brain/organization-protocol",
  "version": "0.0.0-dev.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schemas/organization-authority-descriptor.v1.schema.json": "./schemas/organization-authority-descriptor.v1.schema.json",
    "./schemas/organization-enrollment-request.v1.schema.json": "./schemas/organization-enrollment-request.v1.schema.json",
    "./schemas/organization-enrollment-receipt.v1.schema.json": "./schemas/organization-enrollment-receipt.v1.schema.json",
    "./schemas/organization-installation-access-state.v1.schema.json": "./schemas/organization-installation-access-state.v1.schema.json",
    "./fixtures/onboarding-access-chain.v1.json": "./fixtures/onboarding-access-chain.v1.json"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "schemas/*.schema.json",
    "fixtures/**"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "test": "vitest run --root . --config ../../vitest.package.config.ts"
  },
  "dependencies": {
    "@echo-brain/federation-protocol": "0.0.0-dev.0"
  },
  "engines": {
    "node": "22.22.1",
    "npm": "10.9.4"
  }
}
