{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Foundation-only isolated private capacity lab. This template creates no staging or production resource, permits no SSH or public address, and records reviewed immutable bootstrap inputs. It does not install or launch a candidate, runner, or fixture.",
  "Parameters": {
    "LabVpcCidr": {
      "Type": "String",
      "AllowedPattern": "^[0-9]{1,3}(?:\\.[0-9]{1,3}){3}/(?:[0-9]|[12][0-9]|3[0-2])$",
      "ConstraintDescription": "must be a new private lab VPC IPv4 CIDR selected during review"
    },
    "LabSubnetCidr": {
      "Type": "String",
      "AllowedPattern": "^[0-9]{1,3}(?:\\.[0-9]{1,3}){3}/(?:[0-9]|[12][0-9]|3[0-2])$",
      "ConstraintDescription": "must be a private subnet CIDR wholly inside LabVpcCidr"
    },
    "LabAvailabilityZone": {
      "Type": "String",
      "AllowedPattern": "^us-west-2[a-d]$",
      "ConstraintDescription": "must be one us-west-2 Availability Zone for both candidate and driver"
    },
    "Ubuntu2404X8664AmiId": {
      "Type": "AWS::EC2::Image::Id",
      "AllowedPattern": "^ami-[0-9a-f]{8,17}$",
      "ConstraintDescription": "must be a reviewed, pinned Ubuntu Server 24.04 LTS x86_64 AMI ID, never an alias or latest selector"
    },
    "DriverInstanceType": {
      "Type": "String",
      "Default": "t3.small",
      "AllowedValues": ["t3.small", "t3.medium"],
      "ConstraintDescription": "must be an x86_64 private driver instance type"
    },
    "S3PrefixListId": {
      "Type": "String",
      "AllowedPattern": "^pl-[0-9a-f]+$",
      "ConstraintDescription": "must be the reviewed us-west-2 Amazon S3 managed prefix-list ID"
    },
    "BootstrapArtifactBucket": {
      "Type": "String",
      "AllowedPattern": "^[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]$",
      "ConstraintDescription": "must name the pre-existing private versioned artifact bucket"
    },
    "BootstrapArtifactKey": {
      "Type": "String",
      "AllowedPattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{1,900}\\.tar\\.gz$",
      "ConstraintDescription": "must be a safe content-addressed .tar.gz artifact key"
    },
    "BootstrapArtifactVersion": {
      "Type": "String",
      "AllowedPattern": "^[A-Za-z0-9._/+=-]{8,1024}$",
      "ConstraintDescription": "must be a non-null immutable S3 object version ID"
    },
    "BootstrapArtifactSha256": {
      "Type": "String",
      "AllowedPattern": "^[0-9a-f]{64}$",
      "ConstraintDescription": "must be the SHA-256 of the exact artifact version"
    },
    "BootstrapArtifactSourceCommit": {
      "Type": "String",
      "AllowedPattern": "^[0-9a-f]{40}$",
      "ConstraintDescription": "must be the reviewed source commit that produced the artifact"
    },
    "AnchorRelayProtocolDigest": {
      "Type": "String",
      "AllowedPattern": "^[0-9a-f]{64}$",
      "ConstraintDescription": "must identify the reviewed verifier-owned digest-only external timestamp relay protocol; lab hosts never call a public timestamp authority"
    },
    "LabOperationId": {
      "Type": "String",
      "AllowedPattern": "^capacity-[a-z0-9][a-z0-9-]{7,63}$",
      "ConstraintDescription": "must uniquely identify this isolated capacity-lab review"
    },
    "ExpiresAt": {
      "Type": "String",
      "AllowedPattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "ConstraintDescription": "must be the human-approved UTC lab cleanup deadline"
    }
  },
  "Rules": {
    "RequireUsWest2": {
      "Assertions": [
        {
          "Assert": { "Fn::Equals": [{ "Ref": "AWS::Region" }, "us-west-2"] },
          "AssertDescription": "The capacity V1 hardware profile is pinned to us-west-2."
        }
      ]
    }
  },
  "Resources": {
    "CapacityLabVpc": {
      "Type": "AWS::EC2::VPC",
      "Properties": {
        "CidrBlock": { "Ref": "LabVpcCidr" },
        "EnableDnsHostnames": true,
        "EnableDnsSupport": true,
        "Tags": [
          { "Key": "Application", "Value": "echo-brain" },
          { "Key": "Purpose", "Value": "authority-capacity-lab" },
          { "Key": "OperationId", "Value": { "Ref": "LabOperationId" } },
          { "Key": "ExpiresAt", "Value": { "Ref": "ExpiresAt" } }
        ]
      }
    },
    "CapacityLabSubnet": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": { "Ref": "CapacityLabVpc" },
        "AvailabilityZone": { "Ref": "LabAvailabilityZone" },
        "CidrBlock": { "Ref": "LabSubnetCidr" },
        "MapPublicIpOnLaunch": false,
        "Tags": [
          { "Key": "Purpose", "Value": "authority-capacity-lab-private" },
          { "Key": "OperationId", "Value": { "Ref": "LabOperationId" } },
          { "Key": "ExpiresAt", "Value": { "Ref": "ExpiresAt" } }
        ]
      }
    },
    "CapacityLabRouteTable": {
      "Type": "AWS::EC2::RouteTable",
      "Properties": {
        "VpcId": { "Ref": "CapacityLabVpc" },
        "Tags": [
          { "Key": "Purpose", "Value": "authority-capacity-lab-private-no-internet-route" },
          { "Key": "OperationId", "Value": { "Ref": "LabOperationId" } },
          { "Key": "ExpiresAt", "Value": { "Ref": "ExpiresAt" } }
        ]
      }
    },
    "CapacityLabRouteTableAssociation": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "SubnetId": { "Ref": "CapacityLabSubnet" },
        "RouteTableId": { "Ref": "CapacityLabRouteTable" }
      }
    },
    "CapacityCandidateSecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "Candidate HTTPS accepts only the private driver/verifier host. Egress is explicitly bounded.",
        "VpcId": { "Ref": "CapacityLabVpc" },
        "SecurityGroupIngress": [],
        "SecurityGroupEgress": []
      }
    },
    "CapacityDriverSecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "Driver and fixture HTTPS accepts only the candidate. Egress is explicitly bounded.",
        "VpcId": { "Ref": "CapacityLabVpc" },
        "SecurityGroupIngress": [],
        "SecurityGroupEgress": []
      }
    },
    "CapacityLabEndpointSecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "Private endpoint ingress only from capacity-lab hosts.",
        "VpcId": { "Ref": "CapacityLabVpc" },
        "SecurityGroupIngress": [],
        "SecurityGroupEgress": []
      }
    },
    "CapacityLabEndpointIngress": {
      "Type": "AWS::EC2::SecurityGroupIngress",
      "Properties": {
        "GroupId": { "Fn::GetAtt": ["CapacityLabEndpointSecurityGroup", "GroupId"] },
        "IpProtocol": "tcp",
        "FromPort": 443,
        "ToPort": 443,
        "SourceSecurityGroupId": { "Fn::GetAtt": ["CapacityCandidateSecurityGroup", "GroupId"] },
        "Description": "Candidate only"
      }
    },
    "CapacityLabEndpointIngressFromDriver": {
      "Type": "AWS::EC2::SecurityGroupIngress",
      "Properties": {
        "GroupId": { "Fn::GetAtt": ["CapacityLabEndpointSecurityGroup", "GroupId"] },
        "IpProtocol": "tcp",
        "FromPort": 443,
        "ToPort": 443,
        "SourceSecurityGroupId": { "Fn::GetAtt": ["CapacityDriverSecurityGroup", "GroupId"] },
        "Description": "Driver only"
      }
    },
    "CapacityLabEndpointSelfEgress": {
      "Type": "AWS::EC2::SecurityGroupEgress",
      "Properties": {
        "GroupId": { "Fn::GetAtt": ["CapacityLabEndpointSecurityGroup", "GroupId"] },
        "IpProtocol": "tcp",
        "FromPort": 443,
        "ToPort": 443,
        "DestinationSecurityGroupId": { "Fn::GetAtt": ["CapacityLabEndpointSecurityGroup", "GroupId"] },
        "Description": "Endpoint group HTTPS responses only"
      }
    },
    "CapacityCandidateEndpointEgress": {
      "Type": "AWS::EC2::SecurityGroupEgress",
      "Properties": {
        "GroupId": { "Fn::GetAtt": ["CapacityCandidateSecurityGroup", "GroupId"] },
        "IpProtocol": "tcp",
        "FromPort": 443,
        "ToPort": 443,
        "DestinationSecurityGroupId": { "Fn::GetAtt": ["CapacityLabEndpointSecurityGroup", "GroupId"] },
        "Description": "Only private SSM interface endpoints"
      }
    },
    "CapacityCandidateS3Egress": {
      "Type": "AWS::EC2::SecurityGroupEgress",
      "Properties": {
        "GroupId": { "Fn::GetAtt": ["CapacityCandidateSecurityGroup", "GroupId"] },
        "IpProtocol": "tcp",
        "FromPort": 443,
        "ToPort": 443,
        "DestinationPrefixListId": { "Ref": "S3PrefixListId" },
        "Description": "Only the reviewed regional S3 gateway endpoint path"
      }
    },
    "CapacityDriverEndpointEgress": {
      "Type": "AWS::EC2::SecurityGroupEgress",
      "Properties": {
        "GroupId": { "Fn::GetAtt": ["CapacityDriverSecurityGroup", "GroupId"] },
        "IpProtocol": "tcp",
        "FromPort": 443,
        "ToPort": 443,
        "DestinationSecurityGroupId": { "Fn::GetAtt": ["CapacityLabEndpointSecurityGroup", "GroupId"] },
        "Description": "Only private SSM interface endpoints"
      }
    },
    "CapacityDriverS3Egress": {
      "Type": "AWS::EC2::SecurityGroupEgress",
      "Properties": {
        "GroupId": { "Fn::GetAtt": ["CapacityDriverSecurityGroup", "GroupId"] },
        "IpProtocol": "tcp",
        "FromPort": 443,
        "ToPort": 443,
        "DestinationPrefixListId": { "Ref": "S3PrefixListId" },
        "Description": "Only the reviewed regional S3 gateway endpoint path"
      }
    },
    "CapacityCandidateProviderTlsEgress": {
      "Type": "AWS::EC2::SecurityGroupEgress",
      "Properties": {
        "GroupId": { "Fn::GetAtt": ["CapacityCandidateSecurityGroup", "GroupId"] },
        "IpProtocol": "tcp",
        "FromPort": 443,
        "ToPort": 443,
        "DestinationSecurityGroupId": { "Fn::GetAtt": ["CapacityDriverSecurityGroup", "GroupId"] },
        "Description": "Candidate to private driver fixture provider TLS only"
      }
    },
    "CapacityDriverProviderTlsIngress": {
      "Type": "AWS::EC2::SecurityGroupIngress",
      "Properties": {
        "GroupId": { "Fn::GetAtt": ["CapacityDriverSecurityGroup", "GroupId"] },
        "IpProtocol": "tcp",
        "FromPort": 443,
        "ToPort": 443,
        "SourceSecurityGroupId": { "Fn::GetAtt": ["CapacityCandidateSecurityGroup", "GroupId"] },
        "Description": "Candidate to fixture provider TLS only"
      }
    },
    "CapacityDriverVerifierObserverEgress": {
      "Type": "AWS::EC2::SecurityGroupEgress",
      "Properties": {
        "GroupId": { "Fn::GetAtt": ["CapacityDriverSecurityGroup", "GroupId"] },
        "IpProtocol": "tcp",
        "FromPort": 443,
        "ToPort": 443,
        "DestinationSecurityGroupId": { "Fn::GetAtt": ["CapacityCandidateSecurityGroup", "GroupId"] },
        "Description": "Private driver verifier and observer HTTPS only"
      }
    },
    "CapacityCandidateVerifierObserverIngress": {
      "Type": "AWS::EC2::SecurityGroupIngress",
      "Properties": {
        "GroupId": { "Fn::GetAtt": ["CapacityCandidateSecurityGroup", "GroupId"] },
        "IpProtocol": "tcp",
        "FromPort": 443,
        "ToPort": 443,
        "SourceSecurityGroupId": { "Fn::GetAtt": ["CapacityDriverSecurityGroup", "GroupId"] },
        "Description": "Private driver verifier and observer HTTPS only"
      }
    },
    "CapacityLabSsmEndpoint": {
      "Type": "AWS::EC2::VPCEndpoint",
      "Properties": {
        "VpcId": { "Ref": "CapacityLabVpc" },
        "VpcEndpointType": "Interface",
        "ServiceName": { "Fn::Sub": "com.amazonaws.${AWS::Region}.ssm" },
        "PrivateDnsEnabled": true,
        "SubnetIds": [{ "Ref": "CapacityLabSubnet" }],
        "SecurityGroupIds": [{ "Fn::GetAtt": ["CapacityLabEndpointSecurityGroup", "GroupId"] }],
        "PolicyDocument": { "Version": "2012-10-17", "Statement": [{ "Effect": "Allow", "Principal": "*", "Action": "*", "Resource": "*" }] }
      }
    },
    "CapacityLabSsmMessagesEndpoint": {
      "Type": "AWS::EC2::VPCEndpoint",
      "Properties": {
        "VpcId": { "Ref": "CapacityLabVpc" },
        "VpcEndpointType": "Interface",
        "ServiceName": { "Fn::Sub": "com.amazonaws.${AWS::Region}.ssmmessages" },
        "PrivateDnsEnabled": true,
        "SubnetIds": [{ "Ref": "CapacityLabSubnet" }],
        "SecurityGroupIds": [{ "Fn::GetAtt": ["CapacityLabEndpointSecurityGroup", "GroupId"] }],
        "PolicyDocument": { "Version": "2012-10-17", "Statement": [{ "Effect": "Allow", "Principal": "*", "Action": "*", "Resource": "*" }] }
      }
    },
    "CapacityLabEc2MessagesEndpoint": {
      "Type": "AWS::EC2::VPCEndpoint",
      "Properties": {
        "VpcId": { "Ref": "CapacityLabVpc" },
        "VpcEndpointType": "Interface",
        "ServiceName": { "Fn::Sub": "com.amazonaws.${AWS::Region}.ec2messages" },
        "PrivateDnsEnabled": true,
        "SubnetIds": [{ "Ref": "CapacityLabSubnet" }],
        "SecurityGroupIds": [{ "Fn::GetAtt": ["CapacityLabEndpointSecurityGroup", "GroupId"] }],
        "PolicyDocument": { "Version": "2012-10-17", "Statement": [{ "Effect": "Allow", "Principal": "*", "Action": "*", "Resource": "*" }] }
      }
    },
    "CapacityLabArtifactS3Endpoint": {
      "Type": "AWS::EC2::VPCEndpoint",
      "Properties": {
        "VpcId": { "Ref": "CapacityLabVpc" },
        "VpcEndpointType": "Gateway",
        "ServiceName": { "Fn::Sub": "com.amazonaws.${AWS::Region}.s3" },
        "RouteTableIds": [{ "Ref": "CapacityLabRouteTable" }],
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [{
            "Effect": "Allow",
            "Principal": "*",
            "Action": "s3:GetObjectVersion",
            "Resource": { "Fn::Sub": "arn:${AWS::Partition}:s3:::${BootstrapArtifactBucket}/${BootstrapArtifactKey}" }
          }]
        }
      }
    },
    "CapacityLabHostRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "Description": "Capacity-lab host role: SSM and exactly one reviewed immutable bootstrap artifact.",
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [{ "Effect": "Allow", "Principal": { "Service": "ec2.amazonaws.com" }, "Action": "sts:AssumeRole" }]
        },
        "ManagedPolicyArns": [{ "Fn::Sub": "arn:${AWS::Partition}:iam::aws:policy/AmazonSSMManagedInstanceCore" }],
        "Policies": [{
          "PolicyName": "read-exact-capacity-lab-bootstrap-artifact",
          "PolicyDocument": {
            "Version": "2012-10-17",
            "Statement": [{
              "Effect": "Allow",
              "Action": "s3:GetObjectVersion",
              "Resource": { "Fn::Sub": "arn:${AWS::Partition}:s3:::${BootstrapArtifactBucket}/${BootstrapArtifactKey}" },
              "Condition": { "StringEquals": { "s3:VersionId": { "Ref": "BootstrapArtifactVersion" } } }
            }]
          }
        }]
      }
    },
    "CapacityLabHostInstanceProfile": {
      "Type": "AWS::IAM::InstanceProfile",
      "Properties": { "Roles": [{ "Ref": "CapacityLabHostRole" }] }
    },
    "CapacityLabStateVolume": {
      "Type": "AWS::EC2::Volume",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "AvailabilityZone": { "Ref": "LabAvailabilityZone" },
        "Encrypted": true,
        "Size": 100,
        "VolumeType": "gp3",
        "Iops": 3000,
        "Throughput": 125,
        "Tags": [
          { "Key": "Purpose", "Value": "authority-capacity-lab-candidate-state" },
          { "Key": "OperationId", "Value": { "Ref": "LabOperationId" } },
          { "Key": "ExpiresAt", "Value": { "Ref": "ExpiresAt" } }
        ]
      }
    },
    "CapacityCandidate": {
      "Type": "AWS::EC2::Instance",
      "DependsOn": ["CapacityLabRouteTableAssociation", "CapacityLabSsmEndpoint", "CapacityLabSsmMessagesEndpoint", "CapacityLabEc2MessagesEndpoint", "CapacityLabArtifactS3Endpoint"],
      "Properties": {
        "ImageId": { "Ref": "Ubuntu2404X8664AmiId" },
        "InstanceType": "c7i.xlarge",
        "IamInstanceProfile": { "Ref": "CapacityLabHostInstanceProfile" },
        "NetworkInterfaces": [{
          "DeviceIndex": "0",
          "SubnetId": { "Ref": "CapacityLabSubnet" },
          "GroupSet": [{ "Fn::GetAtt": ["CapacityCandidateSecurityGroup", "GroupId"] }],
          "AssociatePublicIpAddress": false,
          "DeleteOnTermination": true
        }],
        "BlockDeviceMappings": [{ "DeviceName": "/dev/xvda", "Ebs": { "Encrypted": true, "DeleteOnTermination": true, "VolumeType": "gp3" } }],
        "MetadataOptions": { "HttpTokens": "required", "HttpEndpoint": "enabled", "HttpPutResponseHopLimit": 1 },
        "Tags": [
          { "Key": "Purpose", "Value": "authority-capacity-lab-candidate" },
          { "Key": "OperationId", "Value": { "Ref": "LabOperationId" } },
          { "Key": "ExpiresAt", "Value": { "Ref": "ExpiresAt" } },
          { "Key": "BootstrapArtifactSha256", "Value": { "Ref": "BootstrapArtifactSha256" } },
          { "Key": "BootstrapArtifactSourceCommit", "Value": { "Ref": "BootstrapArtifactSourceCommit" } },
          { "Key": "AnchorRelayProtocolDigest", "Value": { "Ref": "AnchorRelayProtocolDigest" } }
        ],
        "UserData": { "Fn::Base64": { "Fn::Sub": "#!/bin/bash\nset -Eeuo pipefail\ninstall -d -m 0755 /etc/echo-capacity\ncat >/etc/echo-capacity/bootstrap-artifact.expected <<'EOF'\nbucket=${BootstrapArtifactBucket}\nkey=${BootstrapArtifactKey}\nversion=${BootstrapArtifactVersion}\nsha256=${BootstrapArtifactSha256}\nsource_commit=${BootstrapArtifactSourceCommit}\nEOF\nchmod 0644 /etc/echo-capacity/bootstrap-artifact.expected\n" } }
      }
    },
    "CapacityCandidateStateAttachment": {
      "Type": "AWS::EC2::VolumeAttachment",
      "Properties": {
        "InstanceId": { "Ref": "CapacityCandidate" },
        "VolumeId": { "Ref": "CapacityLabStateVolume" },
        "Device": "/dev/sdf"
      }
    },
    "CapacityDriver": {
      "Type": "AWS::EC2::Instance",
      "DependsOn": ["CapacityLabRouteTableAssociation", "CapacityLabSsmEndpoint", "CapacityLabSsmMessagesEndpoint", "CapacityLabEc2MessagesEndpoint", "CapacityLabArtifactS3Endpoint"],
      "Properties": {
        "ImageId": { "Ref": "Ubuntu2404X8664AmiId" },
        "InstanceType": { "Ref": "DriverInstanceType" },
        "IamInstanceProfile": { "Ref": "CapacityLabHostInstanceProfile" },
        "NetworkInterfaces": [{
          "DeviceIndex": "0",
          "SubnetId": { "Ref": "CapacityLabSubnet" },
          "GroupSet": [{ "Fn::GetAtt": ["CapacityDriverSecurityGroup", "GroupId"] }],
          "AssociatePublicIpAddress": false,
          "DeleteOnTermination": true
        }],
        "BlockDeviceMappings": [{ "DeviceName": "/dev/xvda", "Ebs": { "Encrypted": true, "DeleteOnTermination": true, "VolumeType": "gp3" } }],
        "MetadataOptions": { "HttpTokens": "required", "HttpEndpoint": "enabled", "HttpPutResponseHopLimit": 1 },
        "Tags": [
          { "Key": "Purpose", "Value": "authority-capacity-lab-driver-and-fixtures" },
          { "Key": "OperationId", "Value": { "Ref": "LabOperationId" } },
          { "Key": "ExpiresAt", "Value": { "Ref": "ExpiresAt" } },
          { "Key": "BootstrapArtifactSha256", "Value": { "Ref": "BootstrapArtifactSha256" } },
          { "Key": "BootstrapArtifactSourceCommit", "Value": { "Ref": "BootstrapArtifactSourceCommit" } },
          { "Key": "AnchorRelayProtocolDigest", "Value": { "Ref": "AnchorRelayProtocolDigest" } }
        ],
        "UserData": { "Fn::Base64": { "Fn::Sub": "#!/bin/bash\nset -Eeuo pipefail\ninstall -d -m 0755 /etc/echo-capacity\ncat >/etc/echo-capacity/bootstrap-artifact.expected <<'EOF'\nbucket=${BootstrapArtifactBucket}\nkey=${BootstrapArtifactKey}\nversion=${BootstrapArtifactVersion}\nsha256=${BootstrapArtifactSha256}\nsource_commit=${BootstrapArtifactSourceCommit}\nEOF\nchmod 0644 /etc/echo-capacity/bootstrap-artifact.expected\n" } }
      }
    }
  },
  "Outputs": {
    "CapacityCandidateInstanceId": { "Description": "Private c7i.xlarge candidate instance in the isolated lab VPC.", "Value": { "Ref": "CapacityCandidate" } },
    "CapacityDriverInstanceId": { "Description": "Private driver and fixture instance in the same Availability Zone.", "Value": { "Ref": "CapacityDriver" } },
    "CapacityStateVolumeId": { "Description": "Retained encrypted 100 GiB gp3 candidate state volume.", "Value": { "Ref": "CapacityLabStateVolume" } },
    "CapacityLabVpcId": { "Description": "Dedicated capacity-lab VPC with no internet gateway or staging reference.", "Value": { "Ref": "CapacityLabVpc" } },
    "BootstrapArtifactDigest": { "Description": "Required reviewed bootstrap artifact SHA-256 recorded on both lab hosts.", "Value": { "Ref": "BootstrapArtifactSha256" } },
    "FoundationReadiness": { "Description": "Foundation only. A human-installed wrapper must verify and install the artifact before any candidate or verifier process may start.", "Value": "not-deploy-ready" }
  }
}
